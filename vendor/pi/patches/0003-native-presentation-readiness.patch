+/**
+ * Seam E: cold presentation and readiness, for a host that owns the terminal Pi runs on.
+ *
+ * Two facts a host cannot get from any 0.84.3 surface live here.
+ *
+ * **Presentation.** A terminal that attaches after startup is cold: it has none of the modes Pi emitted
+ * and none of the image state Pi believes it uploaded. `presentTerminal` reasserts what the renderer owns,
+ * drops the per-terminal image transmission cache, renders one complete frame, and returns a nonce naming
+ * that frame and the geometry it was built at. The nonce means *handed to the terminal*: the bytes were
+ * written to the terminal Pi holds. It is not a client display acknowledgement — proving a client
+ * displayed a frame requires the client to echo the nonce back over the host's own transport, which is
+ * the host's work and is deliberately not modelled here.
+ *
+ * **Readiness.** `native-mounted`, `initialized` and `first-paint` are three separate facts, in no fixed
+ * relation to each other beyond `native-mounted` preceding the rest. Output and input flow from
+ * `native-mounted`, which is why nothing here waits for `initialized`: a blocking `session_start` dialog
+ * needs an attached terminal to answer it. A registrant that arrives after a phase reads it from
+ * {@link nativeReadinessSnapshot} instead of waiting for an event that will not come again.
+ *
+ * The snapshot answers a late *registrant*. It cannot answer a host whose management extension is queued
+ * behind an arbitrary `session_start` handler that never resolves, so the launch-time route is the core
+ * bootstrap sideband in `native-bootstrap.ts`, opened by `main()` before any extension is loaded.
+ *
+ * Nothing in this module holds ledger state, ownership policy, attachment policy or session management.
+ * Those stay in the host.
+ */
+
+import type { PresentationOutcome, PresentationRequest } from "@earendil-works/pi-tui";
+
+/** One attachment's identity and epoch. An epoch strictly increases and is never reused. */
+export type AttachmentEpoch = { attachmentId: string; epoch: number };
+
+/** The host's own geometry revision. Pi echoes it back; only the host can order its own revisions. */
+export type GeometryRevision = number;
+
+export type Readiness =
+	/** The TUI has started. Startup input and output flow from here, before extensions are loaded. */
+	| { phase: "native-mounted" }
+	/** `init()` resolved: extensions loaded and any blocking startup dialog answered. */
+	| { phase: "initialized" }
+	/** One complete frame has been handed to the terminal. */
+	| { phase: "first-paint"; presentationNonce: string };
+
+export type ReadinessPhase = Readiness["phase"];
+
+/** A recorded phase. `sequence` orders phases without implying which phase precedes which. */
+export type ReadinessRecord = Readiness & { sequence: number; atMs: number };
+
+export type PresentTerminalRequest = {
+	attachmentEpoch: AttachmentEpoch;
+	geometryRevision: GeometryRevision;
+	coldTerminal: boolean;
+};
+
+/** Why Pi presented nothing. Each value names a real state; none of them fakes a repaint. */
+export type PresentationRefusal =
+	/** A recognised handoff has given the terminal to a child process. */
+	| "child-owns-terminal"
+	/** A recognised suspension has given the terminal back to the shell. */
+	| "suspended"
+	/** No renderer has mounted yet, or the renderer has stopped. */
+	| "no-native-renderer"
+	/** The active renderer hands the terminal incremental fragments and mints no complete-frame receipt. */
+	| "no-complete-frame-support";
+
+export type PresentTerminalResult =
+	| {
+			presented: true;
+			terminalOwner: "pi";
+			presentationNonce: string;
+			frame: { frameId: string; sequence: number; columns: number; rows: number; byteLength: number };
+			/** The revision the host asked for, echoed. Compare it with `frame.columns`/`frame.rows`. */
+			geometryRevision: GeometryRevision;
+			attachmentEpoch: AttachmentEpoch;
+			cold: boolean;
+			coldReassertion: ColdPresentationReassertion | undefined;
+	  }
+	| {
+			presented: false;
+			/**
+			 * `child` for a recognised handoff to a child process; `suspended` when the shell has the
+			 * terminal; `pi` when Pi holds it but the active renderer cannot produce a complete frame.
+			 *
+			 * Deliberately wider than the design document's `'pi' | 'child'`: that pair cannot express the
+			 * recognised Ctrl+Z suspension, in which neither Pi nor a child owns the terminal.
+			 */
+			terminalOwner: "pi" | "child" | "suspended" | "none";
+			presentationNonce: null;
+			refusal: PresentationRefusal;
+			/** A child-owned terminal's current state cannot be acknowledged from inside Pi. */
+			childAcknowledgement: "unavailable" | "not-applicable";
+			reason: string;
+			attachmentEpoch: AttachmentEpoch;
+			geometryRevision: GeometryRevision;
+	  };
+
+/** What a cold presentation reasserted, re-exported in the host's own vocabulary. */
+export type ColdPresentationReassertion = {
+	terminalModesReemitted: string[];
+	rendererModesReemitted: string[];
+	/**
+	 * The negotiated Kitty keyboard flags Pi reasserted for the cold terminal, or undefined when the
+	 * protocol is not active. Reasserted with the set-flags form, so the terminal's mode stack is untouched
+	 * and the host owes nothing here.
+	 */
+	kittyKeyboardFlagsReemitted: number | undefined;
+	colorSchemeNotifications: boolean;
+	imageProtocol: "kitty" | "iterm2" | null;
+	invalidatedImageIds: number[];
+};
+
+/** Why Pi is not currently the terminal's owner, when it is not. */
+export type TerminalRelease = {
+	owner: "child" | "suspended";
+	/** A recognised release site. Arbitrary extension children are not covered; seam G is. */
+	reason: "external-editor" | "suspend";
+	sinceMs: number;
+};
+
+/** The renderer-facing half of seam E. `InteractiveMode` registers one while it holds a renderer. */
+export interface NativePresentationProvider {
+	present(request: PresentationRequest): PresentationOutcome;
+	/** Undefined while Pi holds the terminal. */
+	release(): TerminalRelease | undefined;
+}
+
+/**
+ * The readiness ledger.
+ *
+ * A phase is recorded once. Subscribers are notified of phases recorded after they subscribe; everything
+ * already reached is read from {@link snapshot}, so a late registrant never waits for a missed event and
+ * never receives a phase twice.
+ */
+export class NativeReadinessLedger {
+	private reached: ReadinessRecord[] = [];
+	private listeners = new Set<(record: ReadinessRecord) => void>();
+	private sequence = 0;
+
+	record(readiness: Readiness): ReadinessRecord | undefined {
+		if (this.reached.some((entry) => entry.phase === readiness.phase)) return undefined;
+		const entry = { ...readiness, sequence: ++this.sequence, atMs: Date.now() } as ReadinessRecord;
+		this.reached.push(entry);
+		for (const listener of this.listeners) listener(entry);
+		return entry;
+	}
+
+	snapshot(): { reached: ReadinessRecord[] } {
+		return { reached: [...this.reached] };
+	}
+
+	reachedPhase(phase: ReadinessPhase): ReadinessRecord | undefined {
+		return this.reached.find((entry) => entry.phase === phase);
+	}
+
+	subscribe(listener: (record: ReadinessRecord) => void): () => void {
+		this.listeners.add(listener);
+		return () => {
+			this.listeners.delete(listener);
+		};
+	}
+}
+
+/**
+ * Seam E's readiness ledger and presentation provider live on the process, not on this module.
+ *
+ * The bundled CLI inlines its dependencies, so a supported caller that imports the installed public module
+ * while the agent is running from the bundle holds a **different copy of this module**. A module-scoped
+ * singleton would give that caller an empty ledger and no provider, and it would report both as if that were
+ * the truth. One process hosts one native UI, so one record describes it, reached through a registered symbol
+ * that every copy resolves to the same way.
+ *
+ * Rules, in order: the record carries its own `version`; an existing record is **reused**, never reset, so a
+ * later import cannot discard phases already reached; and a record this build cannot speak to is **refused**
+ * with both versions named, rather than silently shadowed by a second ledger.
+ *
+ * This is seam E's own state under seam E's own key. It is not shared with, and says nothing about, any other
+ * lane's process state.
+ */
+const NATIVE_PRESENTATION_STATE = Symbol.for("@earendil-works/pi-coding-agent/native-presentation-state");
+export const NATIVE_PRESENTATION_STATE_VERSION = 1;
+
+type NativePresentationState = {
+	version: number;
+	ledger: NativeReadinessLedger;
+	provider: NativePresentationProvider | undefined;
+};
+
+/** Structural, not `instanceof`: the other copy's class object is not this copy's class object. */
+function isUsableState(candidate: unknown): candidate is NativePresentationState {
+	const state = candidate as Partial<NativePresentationState> | undefined;
+	const ledger = state?.ledger as Partial<NativeReadinessLedger> | undefined;
+	return (
+		state?.version === NATIVE_PRESENTATION_STATE_VERSION &&
+		typeof ledger?.record === "function" &&
+		typeof ledger?.snapshot === "function" &&
+		typeof ledger?.subscribe === "function" &&
+		typeof ledger?.reachedPhase === "function"
+	);
+}
+
+function nativePresentationState(): NativePresentationState {
+	const carrier = globalThis as Record<PropertyKey, unknown>;
+	const existing = carrier[NATIVE_PRESENTATION_STATE];
+	if (existing !== undefined) {
+		if (!isUsableState(existing)) {
+			const found = (existing as { version?: unknown })?.version;
+			throw new Error(
+				`native presentation state version ${String(found)} is already on this process and this build ` +
+					`speaks version ${NATIVE_PRESENTATION_STATE_VERSION}. Two incompatible Pi builds are loaded in one ` +
+					`process; load one, or upgrade the older one. Nothing was reset: the existing state is left alone.`,
+			);
+		}
+		return existing;
+	}
+	const created: NativePresentationState = {
+		version: NATIVE_PRESENTATION_STATE_VERSION,
+		ledger: new NativeReadinessLedger(),
+		provider: undefined,
+	};
+	carrier[NATIVE_PRESENTATION_STATE] = created;
+	return created;
+}
+
+/** The process-wide ledger. One Pi process hosts one native UI, so one ledger describes it. */
+export function nativeReadiness(): NativeReadinessLedger {
+	return nativePresentationState().ledger;
+}
+
+export function recordNativeReadiness(readiness: Readiness): ReadinessRecord | undefined {
+	return nativePresentationState().ledger.record(readiness);
+}
+
+/**
+ * Subscribe to readiness phases recorded from now on, and read {@link nativeReadinessSnapshot} for the
+ * phases already reached. Returns an unsubscribe.
+ */
+export function onNativeReadiness(listener: (record: ReadinessRecord) => void): () => void {
+	return nativePresentationState().ledger.subscribe(listener);
+}
+
+export function nativeReadinessSnapshot(): { reached: ReadinessRecord[] } {
+	return nativePresentationState().ledger.snapshot();
+}
+
+export function setNativePresentationProvider(next: NativePresentationProvider | undefined): void {
+	nativePresentationState().provider = next;
+}
+
+function describeReassertion(
+	outcome: Extract<PresentationOutcome, { presented: true }>,
+): ColdPresentationReassertion | undefined {
+	const cold = outcome.receipt.cold;
+	if (!cold) return undefined;
+	return {
+		terminalModesReemitted: cold.terminalModes?.reemitted ?? [],
+		rendererModesReemitted: cold.rendererModes,
+		kittyKeyboardFlagsReemitted: cold.terminalModes?.kittyKeyboard?.reemitted
+			? cold.terminalModes.kittyKeyboard.flags
+			: undefined,
+		colorSchemeNotifications: cold.colorSchemeNotifications,
+		imageProtocol: cold.imageProtocol,
+		invalidatedImageIds: cold.invalidatedImageIds,
+	};
+}
+
+/**
+ * Bring one attachment's terminal up to the current native UI.
+ *
+ * Asynchronous because the design document's signature is, and because a host calls it across its own
+ * transport. The work itself is synchronous: the frame is rendered and handed over before this resolves,
+ * so the returned nonce always names a frame that already exists.
+ */
+export async function presentTerminal(request: PresentTerminalRequest): Promise<PresentTerminalResult> {
+	const active = nativePresentationState().provider;
+	if (!active) {
+		return {
+			presented: false,
+			terminalOwner: "none",
+			presentationNonce: null,
+			refusal: "no-native-renderer",
+			childAcknowledgement: "not-applicable",
+			reason: "no native renderer has registered a presentation provider",
+			attachmentEpoch: request.attachmentEpoch,
+			geometryRevision: request.geometryRevision,
+		};
+	}
