index 0000000000000000000000000000000000000000..d9fc05f9417e3a9efd94646afe323605114248f1
--- /dev/null
+++ b/packages/tui/test/process-terminal-backpressure.ts
@@ -0,0 +1,58 @@
+/**
+ * One cold presentation against a real `ProcessTerminal` whose stdout reports backpressure.
+ *
+ * Run as its own process, not as a case inside the test runner: the only way to observe what
+ * `ProcessTerminal` hands to `process.stdout` is to replace `process.stdout.write`, and a replacement that
+ * returns `false` without ever emitting `drain` stalls the runner's own reporter stream. A child process
+ * has no reporter to stall, so the observation is exact and the suite stays readable.
+ *
+ * Writes its observations as JSON to the path given as the first argument. The terminal negotiates the
+ * Kitty keyboard protocol through its real startup path, by answering the query on stdin.
+ */
+
+import { writeFileSync } from "node:fs";
+import { Text } from "../src/components/text.ts";
+import { ProcessTerminal } from "../src/terminal.ts";
+import { TuiAltScreen } from "../src/tui-alt-screen.ts";
+
+const outputPath = process.argv[2];
+if (!outputPath) throw new Error("usage: process-terminal-backpressure.ts <output json path>");
+
+const chunks: string[] = [];
+const stdout = process.stdout as unknown as { write: unknown };
+// A sink above its high-water mark has accepted the bytes and still returns false. Nothing in Pi reads that
+// boolean, so one presentation must produce exactly one copy of the frame.
+stdout.write = (chunk: string | Uint8Array) => {
+	chunks.push(typeof chunk === "string" ? chunk : Buffer.from(chunk).toString("utf8"));
+	return false;
+};
+
+const terminal = new ProcessTerminal();
+const tui = new TuiAltScreen(terminal);
+tui.addChild(new Text("current ui", 0, 0));
+tui.start();
+// The real negotiation path: the terminal answers the startup query with its Kitty keyboard flags.
+process.stdin.emit("data", "\x1b[?7u");
+
+setTimeout(() => {
+	// Read before the presentation, because `stop()` clears the negotiated state on the way out.
+	const kittyProtocolActive = terminal.kittyProtocolActive;
+	const before = chunks.length;
+	const outcome = tui.presentNow({ requestId: "process:1:1", coldTerminal: true });
+	const emitted = chunks.slice(before);
+	tui.stop();
+	writeFileSync(
+		outputPath,
+		JSON.stringify({
+			kittyProtocolActive,
+			presented: outcome.presented,
+			receipt: outcome.presented ? outcome.receipt : undefined,
+			frameByteLengths: emitted
+				.filter((data) => data.includes("\x1b[?2026h"))
+				.map((data) => Buffer.byteLength(data)),
+			bytes: emitted.join(""),
+		}),
+	);
+	// Stdin was resumed by the terminal's own start path, so the loop would otherwise stay open.
+	process.exit(0);
+}, 100);
