diff --git a/packages/tui/src/native-presentation.ts b/packages/tui/src/native-presentation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..01e7631b6efd3345dc8a90bdba6008f2f1a9c158
--- /dev/null
+++ b/packages/tui/src/native-presentation.ts
@@ -0,0 +1,128 @@
+/**
+ * Native presentation: bringing a terminal that missed startup up to the current native UI.
+ *
+ * A terminal that attaches after Pi started has none of the modes Pi emitted at startup and none of the
+ * terminal-specific image state Pi believes it already uploaded. Forcing a render replays neither:
+ * `resetRenderState()` clears the text screen and layout but leaves the Kitty transmission cache intact,
+ * so the next frame emits a placement for an image the cold terminal never received.
+ *
+ * This module names the three things only the renderer can supply:
+ *
+ * 1. reasserting the renderer-owned and terminal-owned modes without resetting draft, focus, overlays,
+ *    selection, search or scrolling — which is why this is not `stop()` followed by `start()`;
+ * 2. dropping the per-terminal image transmission cache so the next frame retransmits the payloads;
+ * 3. a receipt naming the complete frame the renderer actually handed to the terminal, and the geometry
+ *    it was built at.
+ *
+ * The receipt is minted after the frame bytes are handed to {@link Terminal.write}. That is a local
+ * handoff, not a client display acknowledgement: proving a client displayed the frame requires the client
+ * to echo the receipt back, which is the host's work and is deliberately not modelled here.
+ *
+ * A receipt is minted for a **complete** frame only. Both native renderers also write incremental frames —
+ * changed rows in the fullscreen renderer, changed lines in the main-screen renderer — and those are not
+ * something a presentation nonce may name, so they mint nothing.
+ */
+
+import type { ImageProtocol } from "./terminal-image.ts";
+
+/**
+ * Terminal-owned modes reasserted for a cold terminal.
+ *
+ * Only idempotent modes are re-emitted. The Kitty keyboard protocol is reasserted with the set-flags form
+ * (`CSI = flags ; 1 u`), which rewrites the flags of the current stack entry, and never with the push form
+ * (`CSI > flags u`), which would leave the stack unbalanced against the single pop at shutdown.
+ */
+export interface ReassertedTerminalModes {
+	/** Idempotent mode sequences actually written, named rather than quoted. */
+	reemitted: string[];
+	/**
+	 * The negotiated Kitty keyboard flags and how they were reasserted.
+	 *
+	 * `mechanism: "set-flags"` is `CSI = flags ; 1 u`: it sets the flags of the entry already on the
+	 * terminal's stack, so a terminal that received the startup push ends in the same state and a terminal
+	 * that missed it now has the negotiated flags. Undefined when the protocol is not active.
+	 */
+	kittyKeyboard: { flags: number; reemitted: boolean; mechanism: "set-flags" } | undefined;
+	modifyOtherKeys: boolean;
+	title: string | undefined;
+	progress: boolean;
+}
+
+/** What a cold presentation reasserted. Absent from a warm presentation's receipt. */
+export interface ColdReassertion {
+	/** Undefined when the active {@link Terminal} implementation owns no negotiated mode state. */
+	terminalModes: ReassertedTerminalModes | undefined;
+	/** Renderer-owned modes re-emitted, named. Empty for a renderer that owns none. */
+	rendererModes: string[];
+	colorSchemeNotifications: boolean;
+	imageProtocol: ImageProtocol;
+	/**
+	 * Image ids whose cached transmission was dropped, so the next frame retransmits them in full.
+	 *
+	 * Empty for a renderer that keeps no per-terminal transmission cache: the main-screen renderer carries
+	 * each image's transmission inline in the line it draws, so a redrawn frame retransmits by itself.
+	 */
+	invalidatedImageIds: number[];
+}
+
+/** The complete frame the renderer handed to the terminal. */
+export interface PresentationFrameReceipt {
+	/** Identifies this frame. A presentation acknowledgement carries it back. */
+	frameId: string;
+	/** Monotonic per renderer instance, so a stale acknowledgement is recognisable. */
+	sequence: number;
+	/** The presentation request this frame answers, or undefined for an ordinary render. */
+	requestId: string | undefined;
+	/** The geometry the frame was built at, not the geometry at acknowledgement time. */
+	columns: number;
+	rows: number;
+	/** UTF-8 bytes handed to {@link Terminal.write}, counted with `Buffer.byteLength`. */
+	byteLength: number;
+	cold: ColdReassertion | undefined;
+}
+
+export interface PresentationRequest {
+	requestId: string;
+	coldTerminal: boolean;
+}
+
+export type PresentationUnavailableReason =
+	/** The renderer is stopped. Nothing is painted over whatever now owns the terminal. */
+	| "renderer-stopped"
+	/** The renderer started but has released the screen. */
+	| "screen-released"
+	/**
+	 * This renderer mints no complete-frame receipt. Reported by the capability preflight, before any
+	 * mode byte or render is written, so a refusal never leaves half a presentation behind.
+	 */
+	| "no-complete-frame-support";
+
+export type PresentationOutcome =
+	| { presented: true; receipt: PresentationFrameReceipt }
+	| { presented: false; reason: PresentationUnavailableReason };
+
+export const NATIVE_PRESENTATION_TUI = Symbol.for("@earendil-works/pi-tui/native-presentation");
+
+/**
+ * A renderer that can present to a cold terminal and report frame receipts.
+ *
+ * The symbol brand follows the same optional-capability shape as `ViewportTUI`, so the public `TUI`
+ * interface keeps its 0.84.3 member list and a third-party `TUI` implementation still compiles. Only a
+ * renderer that actually hands complete frames over carries the brand: `TuiBase` supplies the methods but
+ * is not branded, so a third-party subclass is reported as unsupported instead of being asked to present.
+ */
+export interface NativePresentationTui {
+	readonly [NATIVE_PRESENTATION_TUI]: true;
+	/**
+	 * Reassert cold state when asked, render one complete frame synchronously, and return the receipt for
+	 * the frame that was handed to the terminal. Never merely schedules a render.
+	 */
+	presentNow(request: PresentationRequest): PresentationOutcome;
+	onFrameHandedToTerminal(listener: (receipt: PresentationFrameReceipt) => void): () => void;
+	lastFrameReceipt(): PresentationFrameReceipt | undefined;
+}
+
+export function isNativePresentationTui(candidate: unknown): candidate is NativePresentationTui {
+	if (candidate === null || (typeof candidate !== "object" && typeof candidate !== "function")) return false;
+	return (candidate as Record<PropertyKey, unknown>)[NATIVE_PRESENTATION_TUI] === true;
+}
