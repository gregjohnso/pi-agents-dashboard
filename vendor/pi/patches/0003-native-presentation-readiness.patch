+	seam: "E",
+	version: 1,
+	delivers: [
+		"cold presentation that reasserts renderer-owned and terminal-owned modes, including the negotiated Kitty keyboard flags, and invalidates the Kitty transmission cache",
+		"a presentation receipt naming the complete frame handed to the terminal and the geometry it was built at, for the fullscreen and the main-screen renderer",
+		"native-mounted, initialized and first-paint readiness records with a snapshot for late registrants",
+		"a launch-time core bootstrap sideband that reports readiness before any extension is loaded",
+		"a refusal, never a repaint, while a recognised handoff or suspension holds the terminal",
+	],
+	notDelivered: [
+		"seam A durable submission barrier",
+		"seam B labelled ingress",
+		"seam C return authorization",
+		"seam D canonical admission",
+		"seam F terminal profile and response authorization",
+		"seam G child-terminal phase announcements and ordered input drain",
+		"gate 5 child-terminal parity: a child-owned screen is reported unavailable, never reconstructed",
+		"presentation receipts for a third-party TuiBase subclass, which is refused by capability preflight before any byte is written",
+		"client display acknowledgement, which the host proves by echoing the nonce",
+	],
+} as const;
+
+export function nativePresentationCapability(): typeof NATIVE_PRESENTATION_CAPABILITY {
+	return NATIVE_PRESENTATION_CAPABILITY;
+}
