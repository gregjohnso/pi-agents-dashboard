new file mode 100644
index 0000000000000000000000000000000000000000..24cb8c198d28e60153eed870e274a1bc05d3ca5e
--- /dev/null
+++ b/packages/coding-agent/test/native-canonical-admission.test.ts
@@ -0,0 +1,416 @@
+/**
+ * Seam D regression test: canonical admission on exact names.
+ *
+ * Exercises real Pi code — the canonical coordinator, the seam A barrier it shares, and `SessionManager`'s
+ * own naming and exclusive-create rules — against a faithful fake host. The fake stands in for pi-agents'
+ * worker-side reservation journal. It is not that journal: nothing here is durable, nothing is fsynced, and
+ * this proves nothing about Task 14 storage or about the pre-spawn startup reservation Task 16 owns.
+ */
+
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import {
+	type CanonicalAdmission,
+	type CanonicalOperation,
+	nativeCanonicalCapability,
+	runCanonicalOperation,
+} from "../src/core/native-canonical.ts";
+import {
+	nativeSubmissionBarrier,
+	type NativeSubmitHost,
+	setNativeSubmissionHost,
+	type SubmissionEnvelope,
+} from "../src/core/native-submission.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+
+let owners = 0;
+let workspace: string;
+
+/** A faithful fake of the host's canonical obligations. Records only. */
+class FakeCanonicalHost implements NativeSubmitHost {
+	readonly ownerRunId = `canonical-owner-${++owners}`;
+	readonly admitted: CanonicalOperation[] = [];
+	readonly committed: { reservationId: string; nextGeneration: number }[] = [];
+	readonly aborted: { reservationId: string; reason: string }[] = [];
+	readonly refusedSubmissions: string[] = [];
+	reservations = 0;
+	decide: (operation: CanonicalOperation) => Promise<CanonicalAdmission> = async () => ({
+		reservationId: `reservation-${++this.reservations}`,
+	});
+	commit: (commit: { reservationId: string; nextGeneration: number }) => Promise<void> = async () => {};
+
+	async beforeNativeSubmit(envelope: SubmissionEnvelope) {
+		return {
+			authorized: true as const,
+			fence: {
+				submissionId: envelope.submissionId,
+				ownerRunId: this.ownerRunId,
+				bindingGeneration: envelope.binding.generation,
+				nonce: "nonce",
+			},
+		};
+	}
+	async recordEffectivePayload() {
+		return { recorded: true as const };
+	}
+	nativeSubmitOutcome() {}
+
+	async admitCanonicalOperation(operation: CanonicalOperation) {
+		this.admitted.push(operation);
+		return this.decide(operation);
+	}
+	async commitBinding(commit: { reservationId: string; nextGeneration: number }) {
+		this.committed.push(commit);
+		return this.commit(commit);
+	}
+	async abortReservation(abort: { reservationId: string; reason: string }) {
+		this.aborted.push(abort);
+	}
+}
+
+/** Bind an owner session whose canonical file this test controls. */
+function bindOwner(file: string | undefined): { set: (next: string | undefined) => void } {
+	let current = file;
+	nativeSubmissionBarrier.bindOwnerSession(() => current);
+	return {
+		set: (next) => {
+			current = next;
+		},
+	};
+}
+
+function activate(host: NativeSubmitHost | undefined): void {
+	setNativeSubmissionHost(host);
+}
+
+beforeEach(() => {
+	workspace = mkdtempSync(join(tmpdir(), "pi-seam-d-"));
+});
+
+afterEach(() => {
+	activate(undefined);
+	nativeSubmissionBarrier.bindOwnerSession(undefined);
+	rmSync(workspace, { recursive: true, force: true });
+});
+
+describe("seam D: registration", () => {
+	it("leaves canonical behaviour unmanaged with no trio, and asks no host anything", async () => {
+		const host = new FakeCanonicalHost();
+		const partial = {
+			ownerRunId: host.ownerRunId,
+			beforeNativeSubmit: host.beforeNativeSubmit.bind(host),
+			recordEffectivePayload: host.recordEffectivePayload.bind(host),
+			nativeSubmitOutcome: () => {},
+		} satisfies NativeSubmitHost;
+		activate(partial);
+		bindOwner(join(workspace, "own.jsonl"));
+		const result = await runCanonicalOperation({
+			operation: "rename",
+			resolvedTarget: join(workspace, "other.jsonl"),
+			rebinds: false,
+			mutate: () => "mutated",
+		});
+		expect(result).toMatchObject({ ok: true, managed: false, value: "mutated" });
+		expect(host.admitted).toHaveLength(0);
+	});
+
+	it("rejects a partial trio and keeps the complete one", () => {
+		const host = new FakeCanonicalHost();
+		const partial = {
+			ownerRunId: host.ownerRunId,
+			beforeNativeSubmit: host.beforeNativeSubmit.bind(host),
+			recordEffectivePayload: host.recordEffectivePayload.bind(host),
+			nativeSubmitOutcome: () => {},
+			admitCanonicalOperation: host.admitCanonicalOperation.bind(host),
+		} as NativeSubmitHost;
+		expect(() => activate(partial)).toThrow(/all together or not at all/);
+		expect(() => activate(host)).not.toThrow();
+	});
+});
+
+describe("seam D: admission before the first side effect", () => {
+	it("admits the exact resolved name, mutates once, and commits the advanced generation", async () => {
+		const host = new FakeCanonicalHost();
+		activate(host);
+		const owner = bindOwner(join(workspace, "own.jsonl"));
+		const target = join(workspace, "target.jsonl");
+		const trace: string[] = [];
+		host.decide = async (operation) => {
+			trace.push(`admit:${operation.operation}:${operation.resolvedTarget.canonicalFile}`);
+			return { reservationId: `reservation-${++host.reservations}` };
+		};
+		const before = nativeSubmissionBarrier.binding.generation;
+		const result = await runCanonicalOperation({
+			operation: "new",
+			resolvedTarget: target,
+			rebinds: true,
+			mutate: () => {
+				trace.push("mutate");
+				writeFileSync(target, "{}\n", { flag: "wx" });
+				owner.set(target);
+				return "created";
+			},
+		});
+		expect(result.ok).toBe(true);
+		expect(trace).toEqual([`admit:startup:${join(workspace, "own.jsonl")}`, `admit:new:${target}`, "mutate"]);
+		expect(host.committed.at(-1)).toEqual({ reservationId: "reservation-2", nextGeneration: before + 1 });
+		expect(host.aborted).toHaveLength(0);
+	});
+
+	it("commits the unchanged generation for a rename and a delete of another file", async () => {
+		const host = new FakeCanonicalHost();
+		activate(host);
+		bindOwner(join(workspace, "own.jsonl"));
+		const other = join(workspace, "other.jsonl");
+		writeFileSync(other, "{}\n");
+		const generation = nativeSubmissionBarrier.binding.generation;
+		for (const operation of ["rename", "delete"] as const) {
+			const result = await runCanonicalOperation({
+				operation,
+				resolvedTarget: other,
+				rebinds: false,
+				mutate: () => operation,
+			});
+			expect(result.ok).toBe(true);
+		}
+		expect(host.committed.map((entry) => entry.nextGeneration)).toEqual([generation, generation, generation]);
+	});
+});
+
+describe("seam D: exact names are never rerolled", () => {
+	it("fails an admitted branch create whose name was taken, aborts once, and overwrites nothing", async () => {
+		const host = new FakeCanonicalHost();
+		activate(host);
+		bindOwner(join(workspace, "own.jsonl"));
+		const sessions = join(workspace, "sessions");
+		const manager = SessionManager.create(workspace, sessions);
+		manager.appendMessage({ role: "user", content: "hello", timestamp: Date.now() });
+		manager.appendMessage({
+			role: "assistant",
+			content: [{ type: "text", text: "hi" }],
+			api: "anthropic-messages",
+			provider: "test",
+			model: "test",
+			usage: {
+				input: 0,
+				output: 0,
+				cacheRead: 0,
+				cacheWrite: 0,
+				totalTokens: 0,
+				cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+			},
+			stopReason: "stop",
+			timestamp: Date.now(),
+		});
+		const leaf = manager.getEntries().at(-1)!.id;
+		const target = manager.resolveNextSessionFile()!;
+		expect(target.startsWith(sessions)).toBe(true);
+		// The race: the admitted name appears between admission and creation.
+		writeFileSync(target, "squatter\n");
+		await expect(
+			runCanonicalOperation({
+				operation: "fork",
+				resolvedTarget: target,
+				rebinds: true,
+				mutate: () => manager.createBranchedSession(leaf),
+			}),
+		).rejects.toMatchObject({ code: "EEXIST" });
+		expect(readFileSync(target, "utf8")).toBe("squatter\n");
+		// One abort for the fork's reservation, and a commit only for the startup adoption that preceded it.
+		expect(host.aborted.map((entry) => entry.reservationId)).toEqual(["reservation-2"]);
+		expect(host.committed.map((entry) => entry.reservationId)).toEqual(["reservation-1"]);
+	});
+});
+
+describe("seam D: nothing mutates without a live reservation", () => {
+	const cases: { name: string; decide: () => Promise<CanonicalAdmission>; code: string }[] = [
+		{
+			name: "a refusal",
+			decide: async () => ({ refused: true, code: "TARGET_HAS_LIVE_WRITER", message: "owner 7 writes it" }),
+			code: "TARGET_HAS_LIVE_WRITER",
+		},
+		{
+			name: "a thrown handler",
+			decide: async () => {
+				throw new Error("admission exploded");
+			},
+			code: "ADMISSION_UNAVAILABLE",
+		},
+		{
+			name: "a malformed decision",
+			decide: async () => ({ reservationId: "" }) as CanonicalAdmission,
+			code: "ADMISSION_UNAVAILABLE",
+		},
+		{
+			name: "a v1 forwardTo arm, which is not forwarded",
+			decide: async () => ({ forwardTo: { canonicalFile: "/elsewhere.jsonl" } }) as unknown as CanonicalAdmission,
+			code: "ADMISSION_UNAVAILABLE",
+		},
+	];
+	for (const entry of cases) {
+		it(`performs no mutation for ${entry.name}`, async () => {
+			const host = new FakeCanonicalHost();
+			activate(host);
+			bindOwner(join(workspace, "own.jsonl"));
+			let mutations = 0;
+			host.decide = entry.decide;
+			const result = await runCanonicalOperation({
+				operation: "delete",
+				resolvedTarget: join(workspace, "other.jsonl"),
+				rebinds: false,
+				mutate: () => ++mutations,
+			});
+			expect(result).toMatchObject({ ok: false, code: entry.code });
+			expect(mutations).toBe(0);
+			expect(host.committed).toHaveLength(0);
+		});
+	}
+
+	it("lets two operations await admission concurrently while only one consumes its reservation", async () => {
+		const host = new FakeCanonicalHost();
+		activate(host);
+		bindOwner(join(workspace, "own.jsonl"));
+		host.decide = async (operation) => {
+			if (operation.operation === "startup") return { reservationId: "startup" };
+			// One host, one reservation id for both in-flight operations: only one may consume it.
+			return { reservationId: "contended" };
+		};
+		let mutations = 0;
+		const mutate = () => ++mutations;
+		const [first, second] = await Promise.all([
+			runCanonicalOperation({ operation: "rename", resolvedTarget: join(workspace, "a.jsonl"), rebinds: false, mutate }),
+			runCanonicalOperation({ operation: "delete", resolvedTarget: join(workspace, "b.jsonl"), rebinds: false, mutate }),
+		]);
+		const outcomes = [first, second];
+		expect(outcomes.filter((outcome) => outcome.ok)).toHaveLength(1);
+		const refused = outcomes.find((outcome) => !outcome.ok) as { ok: false; code: string };
+		expect(["DUPLICATE_OPERATION", "STALE_BINDING", "PERSISTENCE_UNCERTAIN"]).toContain(refused.code);
+		expect(mutations).toBe(1);
+	});
+
+	it("refuses a stale binding when the owner rebinds while admission is pending, and aborts it", async () => {
+		const host = new FakeCanonicalHost();
+		activate(host);
+		const owner = bindOwner(join(workspace, "own.jsonl"));
+		let mutations = 0;
+		host.decide = async (operation) => {
+			if (operation.operation !== "startup") owner.set(join(workspace, "moved.jsonl"));
+			return { reservationId: `reservation-${++host.reservations}` };
+		};
+		const result = await runCanonicalOperation({
+			operation: "rename",
+			resolvedTarget: join(workspace, "other.jsonl"),
+			rebinds: false,
+			mutate: () => ++mutations,
+		});
+		expect(result).toMatchObject({ ok: false, code: "STALE_BINDING" });
+		expect(mutations).toBe(0);
+		expect(host.aborted).toHaveLength(1);
+		expect(host.committed).toHaveLength(1);
+	});
+});
+
+describe("seam D: unresolved persistence fails closed, including for seam A", () => {
+	it("blocks later canonical mutations and submission authorization after a lost commit receipt", async () => {
+		const host = new FakeCanonicalHost();
+		activate(host);
+		bindOwner(join(workspace, "own.jsonl"));
+		host.commit = async () => {
+			throw new Error("commit receipt lost");
+		};
+		const first = await runCanonicalOperation({
+			operation: "rename",
+			resolvedTarget: join(workspace, "other.jsonl"),
+			rebinds: false,
+			mutate: () => "renamed",
+		});
