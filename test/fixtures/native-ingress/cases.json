{
  "manifestVersion": 1,
  "name": "native-ingress-lane",
  "description": "Input lane (seams B/C/F) cases. Both test files drive the built native pipeline named by PI_NATIVE_ARTIFACTS_MANIFEST, so the same two cases record behavioral RED against the unpatched pinned 0.84.3 install and GREEN against the patched cohort. Typecheck and package are the repository's own checks against the patched worktree.",
  "cases": [
    {
      "id": "native-ingress",
      "kind": "test",
      "config": "vitest.config.ts",
      "file": "test/native-ingress.test.mjs",
      "command": ["npx", "--no-install", "vitest", "run", "--config", "vitest.config.ts", "test/native-ingress.test.mjs", "--no-cache"]
    },
    {
      "id": "native-return",
      "kind": "test",
      "config": "vitest.config.ts",
      "file": "test/native-return.test.mjs",
      "command": ["npx", "--no-install", "vitest", "run", "--config", "vitest.config.ts", "test/native-return.test.mjs", "--no-cache"]
    },
    {
      "id": "typecheck",
      "kind": "typecheck",
      "task": "typecheck",
      "command": ["typecheck"]
    },
    {
      "id": "package",
      "kind": "package",
      "task": "pack-check",
      "command": ["pack-check"]
    }
  ]
}
