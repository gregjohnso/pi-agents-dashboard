+	const release = active.release();
+	if (release) {
+		return {
+			presented: false,
+			terminalOwner: release.owner,
+			presentationNonce: null,
+			refusal: release.owner === "child" ? "child-owns-terminal" : "suspended",
+			childAcknowledgement: release.owner === "child" ? "unavailable" : "not-applicable",
+			reason: `Pi released the terminal at a recognised ${release.reason} handoff; it is not painted over, and a child-owned screen cannot be reconstructed from inside Pi`,
+			attachmentEpoch: request.attachmentEpoch,
+			geometryRevision: request.geometryRevision,
+		};
+	}
+
+	const outcome = active.present({
+		requestId: `${request.attachmentEpoch.attachmentId}:${request.attachmentEpoch.epoch}:${request.geometryRevision}`,
+		coldTerminal: request.coldTerminal,
+	});
+	if (!outcome.presented) {
+		return {
+			presented: false,
+			terminalOwner: outcome.reason === "no-complete-frame-support" ? "pi" : "none",
+			presentationNonce: null,
+			refusal: outcome.reason === "no-complete-frame-support" ? "no-complete-frame-support" : "no-native-renderer",
+			childAcknowledgement: "not-applicable",
+			reason: `the active renderer presented nothing: ${outcome.reason}`,
+			attachmentEpoch: request.attachmentEpoch,
+			geometryRevision: request.geometryRevision,
+		};
+	}
+
+	return {
+		presented: true,
+		terminalOwner: "pi",
+		presentationNonce: outcome.receipt.frameId,
+		frame: {
+			frameId: outcome.receipt.frameId,
+			sequence: outcome.receipt.sequence,
+			columns: outcome.receipt.columns,
+			rows: outcome.receipt.rows,
+			byteLength: outcome.receipt.byteLength,
+		},
+		geometryRevision: request.geometryRevision,
+		attachmentEpoch: request.attachmentEpoch,
+		cold: request.coldTerminal,
+		coldReassertion: describeReassertion(outcome),
+	};
