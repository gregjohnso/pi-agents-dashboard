+/**
+ * Seam D regression test: canonical admission on exact names.
+ *
+ * Exercises real Pi code — the canonical coordinator, the seam A barrier it shares, and `SessionManager`'s
+ * own naming and exclusive-create rules — against a faithful fake host. The fake stands in for pi-agents'
+ * worker-side reservation journal. It is not that journal: nothing here is durable, nothing is fsynced, and
+ * this proves nothing about Task 14 storage or about the pre-spawn startup reservation Task 16 owns.
+ */
+
+import { appendFileSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import {
+	CANONICAL_REFUSAL_CODES,
+	type CanonicalAdmission,
+	type CanonicalOperation,
+	nativeCanonicalCapability,
+	nativeCanonicalCoordinator,
+	runCanonicalOperation,
+} from "../src/core/native-canonical.ts";
+import {
+	nativeSubmissionBarrier,
+	type NativeSubmitHost,
+	setNativeSubmissionHost,
+	type SubmissionEnvelope,
+} from "../src/core/native-submission.ts";
+import { CURRENT_SESSION_VERSION, SessionManager } from "../src/core/session-manager.ts";
+
+let owners = 0;
+let workspace: string;
+
+/** A faithful fake of the host's canonical obligations. Records only. */
+class FakeCanonicalHost implements NativeSubmitHost {
+	readonly ownerRunId = `canonical-owner-${++owners}`;
+	readonly admitted: CanonicalOperation[] = [];
+	readonly committed: { reservationId: string; nextGeneration: number }[] = [];
+	readonly aborted: { reservationId: string; reason: string }[] = [];
+	readonly refusedSubmissions: string[] = [];
+	reservations = 0;
+	decide: (operation: CanonicalOperation) => Promise<CanonicalAdmission> = async () => ({
+		reservationId: `reservation-${++this.reservations}`,
+	});
+	commit: (commit: { reservationId: string; nextGeneration: number }) => Promise<void> = async () => {};
+
+	async beforeNativeSubmit(envelope: SubmissionEnvelope) {
+		return {
+			authorized: true as const,
+			fence: {
+				submissionId: envelope.submissionId,
+				ownerRunId: this.ownerRunId,
+				bindingGeneration: envelope.binding.generation,
+				nonce: "nonce",
+			},
+		};
+	}
+	async recordEffectivePayload() {
+		return { recorded: true as const };
+	}
+	nativeSubmitOutcome() {}
+
+	async admitCanonicalOperation(operation: CanonicalOperation) {
+		this.admitted.push(operation);
+		return this.decide(operation);
+	}
+	async commitBinding(commit: { reservationId: string; nextGeneration: number }) {
+		this.committed.push(commit);
+		return this.commit(commit);
+	}
+	async abortReservation(abort: { reservationId: string; reason: string }) {
+		this.aborted.push(abort);
+	}
+}
+
+/** Bind an owner session whose canonical file this test controls. */
+function bindOwner(file: string | undefined): { set: (next: string | undefined) => void } {
+	let current = file;
+	nativeSubmissionBarrier.bindOwnerSession(() => current);
+	return {
+		set: (next) => {
+			current = next;
+		},
+	};
+}
+
+function activate(host: NativeSubmitHost | undefined): void {
+	setNativeSubmissionHost(host);
+}
+
+beforeEach(() => {
+	workspace = mkdtempSync(join(tmpdir(), "pi-seam-d-"));
+});
+
+afterEach(() => {
+	activate(undefined);
+	nativeSubmissionBarrier.bindOwnerSession(undefined);
+	rmSync(workspace, { recursive: true, force: true });
+});
+
+describe("seam D: registration", () => {
+	it("leaves canonical behaviour unmanaged with no trio, and asks no host anything", async () => {
+		const host = new FakeCanonicalHost();
+		const partial = {
+			ownerRunId: host.ownerRunId,
+			beforeNativeSubmit: host.beforeNativeSubmit.bind(host),
+			recordEffectivePayload: host.recordEffectivePayload.bind(host),
+			nativeSubmitOutcome: () => {},
+		} satisfies NativeSubmitHost;
+		activate(partial);
+		bindOwner(join(workspace, "own.jsonl"));
+		const result = await runCanonicalOperation({
+			operation: "rename",
+			resolvedTarget: join(workspace, "other.jsonl"),
+			mutate: () => "mutated",
+		});
+		expect(result).toMatchObject({ ok: true, managed: false, value: "mutated" });
+		expect(host.admitted).toHaveLength(0);
+	});
+
+	it("rejects a partial trio and keeps the complete one", () => {
+		const host = new FakeCanonicalHost();
+		const partial = {
+			ownerRunId: host.ownerRunId,
+			beforeNativeSubmit: host.beforeNativeSubmit.bind(host),
+			recordEffectivePayload: host.recordEffectivePayload.bind(host),
+			nativeSubmitOutcome: () => {},
+			admitCanonicalOperation: host.admitCanonicalOperation.bind(host),
+		} as NativeSubmitHost;
+		expect(() => activate(partial)).toThrow(/all together or not at all/);
+		expect(() => activate(host)).not.toThrow();
+	});
