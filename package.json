{
  "name": "pi-agents",
  "version": "0.0.2",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "bin": {
    "pi-agents": "./bin/pi-agents.mjs"
  },
  "files": [
    "app/**/*.mjs",
    "bin/*.mjs",
    "cli/*.mjs",
    "runtime/*.mjs",
    "shared/*.mjs",
    "isolation/*.mjs",
    "!**/*.test.mjs",
    "!**/*.integration.test.mjs",
    "!runtime/test-fixtures.mjs",
    "README.md",
    "LICENSE"
  ],
  "bundleDependencies": [
    "@earendil-works/pi-coding-agent",
    "@earendil-works/pi-tui"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --project tsconfig.app.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.*' --exclude '**/*.acceptance.test.*' --exclude '**/*.tmux.test.*'",
    "test:integration": "vitest run runtime/*.integration.test.mjs test/*.integration.test.mjs",
    "test:acceptance": "vitest run test/*.acceptance.test.mjs",
    "test:qualification": "vitest run --config vitest.qualification.config.ts",
    "pack:check": "npm pack --dry-run --json"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
