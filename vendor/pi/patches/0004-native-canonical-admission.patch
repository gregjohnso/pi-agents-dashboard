+		expect(grant).toMatchObject({ managed: true, granted: false, refusal: { code: "PERSISTENCE_UNCERTAIN" } });
+	});
+
+	it("enters uncertainty for an ambiguous mutation throw and does not abort it", async () => {
+		const host = new FakeCanonicalHost();
+		activate(host);
+		bindOwner(join(workspace, "own.jsonl"));
+		await expect(
+			runCanonicalOperation({
+				operation: "delete",
+				resolvedTarget: join(workspace, "other.jsonl"),
+				rebinds: false,
+				mutate: () => {
+					throw new Error("half-written");
+				},
+			}),
+		).rejects.toThrow(/half-written/);
+		expect(host.aborted).toHaveLength(0);
+		const later = await runCanonicalOperation({
+			operation: "rename",
+			resolvedTarget: join(workspace, "other.jsonl"),
+			rebinds: false,
+			mutate: () => "renamed",
+		});
+		expect(later).toMatchObject({ ok: false, code: "PERSISTENCE_UNCERTAIN" });
+	});
+});
+
+describe("seam D: the synchronous section is not re-entrant", () => {
+	it("refuses a canonical operation a host starts from inside a mutation, and mutates once", async () => {
+		const host = new FakeCanonicalHost();
+		activate(host);
+		bindOwner(join(workspace, "own.jsonl"));
+		let mutations = 0;
+		let reentrant: unknown;
+		const result = await runCanonicalOperation({
+			operation: "rename",
+			resolvedTarget: join(workspace, "other.jsonl"),
+			rebinds: false,
+			mutate: () => {
+				mutations += 1;
+				// A host that calls back into Pi from inside the section gets a definite refusal, not a
+				// deadlock and not a second mutation.
+				reentrant = nativeSubmissionBarrier.runCanonicalMutation.bind(nativeSubmissionBarrier);
+				expect(() => (reentrant as (mutate: () => void) => void)(() => (mutations += 1))).toThrow(
+					/cannot be re-entered/,
+				);
+				return "renamed";
+			},
+		});
+		expect(result.ok).toBe(true);
+		expect(mutations).toBe(1);
+	});
+});
+
+describe("seam D: the capability declaration", () => {
+	it("names seam D only and does not claim the host's durability or the startup reservation", () => {
+		const capability = nativeCanonicalCapability();
+		expect(capability.seam).toBe("D");
+		expect(capability.version).toBe(1);
+		const notDelivered = capability.notDelivered.join(" ");
