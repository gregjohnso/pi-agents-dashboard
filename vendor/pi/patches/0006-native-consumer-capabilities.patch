+			Buffer.from(`${encodeNativePresentBegin(token)}frame${encodeNativePresentEnd(token, frameId)}`, "latin1"),
+		]);
+		const ended = events.find((event) => event.kind === "end");
+		assert.equal(ended?.kind === "end" ? ended.frameId : undefined, frameId);
+		assert.equal(ended?.kind === "end" ? ended.token : undefined, token);
+		// A result naming a different frame does not match this interval, whichever arrived first.
+		assert.notEqual(ended?.kind === "end" ? ended.frameId : undefined, randomUUID());
+	});
+
+	it("streams megabytes without accumulating them", () => {		const decoder = new NativePresentMarkerDecoder();
+		decoder.arm(token);
+		decoder.decode(Buffer.from(encodeNativePresentBegin(token), "latin1"));
+		const chunk = Buffer.alloc(16 * 1024, 0x61);
+		let forwarded = 0;
+		for (let index = 0; index < 128; index += 1) {
+			for (const event of decoder.decode(chunk)) {
+				if (event.kind === "bytes") forwarded += event.bytes.length;
+			}
+			assert.ok(decoder.retainedBytes() <= NATIVE_PRESENT_MARKER_MAX_BYTES);
+		}
+		assert.equal(forwarded, 128 * chunk.length, "every byte was forwarded, none retained");
+		assert.deepEqual(
+			decoder.decode(Buffer.from(encodeNativePresentEnd(token, frameId), "latin1")).map((event) => event.kind),
+			["end"],
+		);
+	});
+});
+
+describe("ordered presentation on the renderer's own write path", () => {
+	class RecordingTerminal extends VirtualTerminal {
+		readonly writes: string[] = [];
+
+		override write(data: string): void {
+			this.writes.push(data);
+			super.write(data);
+		}
+
+		since(index: number): string {
+			return this.writes.slice(index).join("");
+		}
+	}
+
+	/** Both native renderers: the fullscreen one and the main-screen one. */
+	const renderers: [string, (terminal: RecordingTerminal) => TuiAltScreen | TuiMainScreen][] = [
+		["TuiAltScreen", (terminal) => new TuiAltScreen(terminal)],
+		["TuiMainScreen", (terminal) => new TuiMainScreen(terminal)],
+	];
+
+	for (const [name, create] of renderers) {
+		it(`${name} writes no marker byte when no ordering was requested`, () => {
+			const terminal = new RecordingTerminal();
+			const tui = create(terminal);
+			tui.addChild(new Text("current ui", 0, 0));
+			tui.start();
+			const before = terminal.writes.length;
+			const outcome = tui.presentNow({ requestId: "plain:1:1", coldTerminal: true });
+			const emitted = terminal.since(before);
+			tui.stop();
+			assert.equal(outcome.presented, true);
+			assert.ok(!emitted.includes("pi-native-present"), "default output carries no marker");
+			assert.equal(outcome.presented && outcome.receipt.ordering, undefined);
+		});
+
+		it(`${name} brackets exactly the requested frame, and the decoder recovers it`, () => {
+			const token = mintNativePresentToken();
+			const terminal = new RecordingTerminal();
+			const tui = create(terminal);
+			tui.addChild(new Text("current ui", 0, 0));
+			tui.start();
+			const before = terminal.writes.length;
+			const outcome = tui.presentNow({
+				requestId: "ordered:1:1",
+				coldTerminal: true,
+				ordering: { version: NATIVE_PRESENT_ORDERING_VERSION, token },
+			});
+			const emitted = terminal.since(before);
+			tui.stop();
+			assert.ok(outcome.presented);
+			assert.deepEqual(outcome.receipt.ordering, {
+				version: NATIVE_PRESENT_ORDERING_VERSION,
+				token,
+				markerCodec: NATIVE_PRESENT_MARKER_CODEC,
+			});
+			// BEGIN is the first byte of the interval and END the last: the cold reassertion and the frame are
+			// inside, and nothing else is.
+			assert.ok(emitted.startsWith(encodeNativePresentBegin(token)));
+			assert.ok(emitted.endsWith(encodeNativePresentEnd(token, outcome.receipt.frameId)));
+			const decoder = new NativePresentMarkerDecoder();
+			decoder.arm(token);
+			const events = decoder.decode(Buffer.from(emitted, "latin1"));
+			assert.equal(events[0].kind, "begin");
+			assert.equal(events[events.length - 1].kind, "end");
+			const ended = events[events.length - 1];
+			assert.equal(ended.kind === "end" ? ended.frameId : undefined, outcome.receipt.frameId);
+			const carried = events
+				.filter((event) => event.kind === "bytes")
+				.map((event) => Buffer.from(event.bytes).toString("latin1"))
+				.join("");
+			assert.equal(Buffer.byteLength(carried, "latin1") > 0, true);
+			assert.equal(decoder.retainedBytes(), 0);
+		});
+
+		it(`${name} refuses an ordering it does not speak before writing anything`, () => {
+			const terminal = new RecordingTerminal();
+			const tui = create(terminal);
+			tui.addChild(new Text("current ui", 0, 0));
+			tui.start();
+			const before = terminal.writes.length;
+			const unknownVersion = tui.presentNow({
+				requestId: "bad-version:1:1",
+				coldTerminal: true,
+				ordering: { version: 99, token: mintNativePresentToken() },
+			});
+			const badToken = tui.presentNow({
+				requestId: "bad-token:1:1",
+				coldTerminal: true,
+				ordering: { version: NATIVE_PRESENT_ORDERING_VERSION, token: "not-a-token" },
+			});
+			const emitted = terminal.since(before);
+			tui.stop();
+			assert.deepEqual(unknownVersion, { presented: false, reason: "unsupported-ordering" });
+			assert.deepEqual(badToken, { presented: false, reason: "unsupported-ordering" });
+			assert.equal(emitted, "", "a refused ordering writes no byte at all");
+		});
+	}
+
+	it("closes the interval with ABORT when no complete frame was produced", () => {
+		const token = mintNativePresentToken();
+		const terminal = new RecordingTerminal();
+		// `TuiAltScreen` with a render that throws: the interval has to close, and the bytes already written
+		// stay written. Only a later complete presentation recovers the screen.
+		const tui = new TuiAltScreen(terminal);
+		tui.addChild(new Text("current ui", 0, 0));
+		tui.start();
+		const failing = tui as unknown as { renderNow(force?: boolean): void };
+		const realRender = failing.renderNow.bind(failing);
+		failing.renderNow = () => {
+			throw new Error("render failed");
+		};
+		const before = terminal.writes.length;
+		assert.throws(() =>
+			tui.presentNow({
+				requestId: "aborted:1:1",
+				coldTerminal: false,
+				ordering: { version: NATIVE_PRESENT_ORDERING_VERSION, token },
+			}),
+		);
+		const emitted = terminal.since(before);
+		failing.renderNow = realRender;
+		tui.stop();
+		const decoder = new NativePresentMarkerDecoder();
+		decoder.arm(token);
+		assert.deepEqual(
+			decoder.decode(Buffer.from(emitted, "latin1")).map((event) => event.kind),
+			["begin", "abort"],
+		);
+	});
+});
