index 0000000000000000000000000000000000000000..25ce9b22624694a2ac68d10009b83fcd21768b09
--- /dev/null
+++ b/packages/coding-agent/src/core/native-canonical.ts
@@ -0,0 +1,510 @@
+/**
+ * Seam D: canonical admission on exact names.
+ *
+ * A managed host (pi-agents) that already registered a `NativeSubmitHost` may also carry the canonical
+ * trio — `admitCanonicalOperation`, `commitBinding`, `abortReservation`. When it does, every owner-controlled
+ * native operation that creates, opens, copies, appends to or unlinks a *session file* asks the host for
+ * admission on the **exact final path**, before the first of those side effects, and commits the resulting
+ * binding afterwards. With no trio the canonical path is byte-for-byte the unmanaged one.
+ *
+ * Nothing here persists anything, locks anything or knows what a registry row is. The durable reservation
+ * journal, the session-directory lock, inode identity and `OwnerRunIdentity` are the host's; this file is the
+ * control point and the vocabulary.
+ *
+ * Three structural rules carry the weight:
+ *
+ * 1. **The name is resolved before the reservation.** Pi computes the final filename with its own naming
+ *    rules — suffix included — admits *that* path, and never picks another one. An admitted create that finds
+ *    the name taken fails the operation and aborts its reservation; it does not reroll a suffix or overwrite.
+ * 2. **Seam A and seam D share one binding source and one synchronous critical section.** The binding comes
+ *    only from the active owner's own session through the barrier's supplier, and the fence check, the
+ *    reservation consumption and the native mutation run in one uninterrupted turn. Nothing is ever awaited
+ *    while that section is held, and a rebind is committed only once that same supplier reports the admitted
+ *    target and its own generation.
+ * 3. **Unresolved persistence fails closed.** While a commit is pending, and permanently after a lost commit
+ *    receipt or an ambiguously failed mutation, every later canonical mutation and every seam A
+ *    authorization or dispatch is refused with `PERSISTENCE_UNCERTAIN`. Nothing is rolled back, replayed,
+ *    committed twice or aborted on a guess.
+ *
+ * There is deliberately no `forwardTo` arm in v1 (G-A3's allowed alternative): a live-writer conflict is a
+ * visible refusal with retry and attachment guidance, and no routing protocol is invented here.
+ */
+
+import { randomUUID } from "node:crypto";
+import { type NativeSubmitBinding, nativeSubmissionBarrier } from "./native-submission.ts";
+/** Every owner-controlled native operation that resolves a canonical session file. */
+export type CanonicalOperationKind = "startup" | "new" | "fork" | "resume" | "import" | "rename" | "delete";
+
+export interface CanonicalOperation {
+	operationId: string;
+	operation: CanonicalOperationKind;
+	/** The owner's binding as observed from its own active session, immediately before this request. */
+	currentBinding: NativeSubmitBinding;
+	/** The EXACT normalized absolute final path, resolved by Pi before admission. Never a directory pattern. */
+	resolvedTarget: { canonicalFile: string };
+}
+
+/** The five public refusal codes, exactly. A decision naming anything else is malformed. */
+export const CANONICAL_REFUSAL_CODES = [
+	"TARGET_HAS_LIVE_WRITER",
+	"TARGET_UNCERTAIN",
+	"STALE_BINDING",
+	"DUPLICATE_OPERATION",
+	"ADMISSION_UNAVAILABLE",
+] as const;
+
+export type CanonicalRefusalCode = (typeof CANONICAL_REFUSAL_CODES)[number];
+
+export type CanonicalAdmission =
+	| { reservationId: string }
+	| { refused: true; code: CanonicalRefusalCode; message: string };
+
+/**
+ * The canonical trio, as optional members of the seam A host.
+ *
+ * Registration takes all three or none: a partial trio is rejected at `setNativeSubmissionHost`, because a
+ * host that can admit but cannot commit would leave every admitted operation permanently unresolved.
+ */
+export interface NativeCanonicalHost {
+	admitCanonicalOperation(operation: CanonicalOperation): Promise<CanonicalAdmission>;
+	commitBinding(commit: { reservationId: string; nextGeneration: number }): Promise<void>;
+	abortReservation(abort: { reservationId: string; reason: string }): Promise<void>;
+}
+
+export type CanonicalCoordinatorState = "READY" | "COMMIT_PENDING" | "UNCERTAIN";
+
+/** Every refusal a call site can receive, including the fail-closed one seam A shares. */
+export type CanonicalOperationRefusalCode = CanonicalRefusalCode | "PERSISTENCE_UNCERTAIN";
+
+export type CanonicalOperationResult<T> =
+	| { ok: true; managed: boolean; value: T; reservationId: string | undefined; nextGeneration: number | undefined }
+	| { ok: false; code: CanonicalOperationRefusalCode; message: string };
+
+/**
+ * Thrown *by an admitted mutation* that performed no canonical side effect: a validated precondition that
+ * failed, or a cancellation. The wrapper aborts the reservation, rethrows the original `cause`, and does not
+ * enter mutation uncertainty. Any other throw is uncertainty, because it may have begun a write.
+ */
+export class CanonicalMutationNotPerformedError extends Error {
+	override readonly cause: unknown;
+
+	constructor(cause: unknown) {
+		super(`canonical mutation performed nothing: ${describeError(cause)}`);
+		this.name = "CanonicalMutationNotPerformedError";
+		this.cause = cause;
+	}
+}
+
+export interface CanonicalOperationRequest<T> {
+	operation: CanonicalOperationKind;
+	/** The exact normalized absolute file this operation creates, opens, copies, appends to or unlinks. */
+	resolvedTarget: string;
+	/** The one native mutation. Must be synchronous: it runs inside the shared critical section. */
+	mutate: () => T;
+	/**
+	 * The asynchronous replacement that actually moves this owner's binding onto `resolvedTarget`: the call
+	 * site's own session teardown and runtime creation. Present for a rebind (`new`, `fork`, `resume`,
+	 * `import`) and absent for an operation on another file (`rename`, `delete`, startup adoption).
+	 *
+	 * It runs after the synchronous mutation and outside the synchronous section, while every later protected
+	 * canonical mutation and every seam A boundary is already blocked. The commit that follows carries the
+	 * generation the active-owner supplier itself reports once this resolved — never one computed from the
+	 * requested target.
+	 */
+	rebind?: (value: T) => Promise<void>;
+	/**
+	 * True only where this mutation's first write is an exclusive create of `resolvedTarget` — `wx` or
+	 * `COPYFILE_EXCL` — so an `EEXIST` from it proves no byte changed. Everywhere else an `EEXIST` may follow
+	 * a side effect and is mutation uncertainty, not a definite no-mutation abort.
+	 */
+	exclusiveCreate?: boolean;
+}
+
+interface Reservation {
+	reservationId: string;
+	operationId: string;
+	ownerRunId: string;
+	target: string;
+	admittedBinding: NativeSubmitBinding;
+	consumed: boolean;
+}
+
+/**
+ * The owner-local canonical coordinator.
+ *
+ * It extends the seam A barrier rather than duplicating it: the binding comes from the barrier's own
+ * active-owner supplier, and the mutation runs inside the barrier's own synchronous critical section, so an
+ * admitted canonical mutation and a submission fence consumption can never interleave.
+ */
+class NativeCanonicalCoordinator {
+	#state: CanonicalCoordinatorState = "READY";
+	#reservations = new Map<string, Reservation>();
+	#operationIds = new Map<string, string>();
+	#ownerRunId: string | undefined;
+	#startupAdoption: Promise<{ ok: false; code: CanonicalOperationRefusalCode; message: string } | undefined> | undefined;
+
+	get state(): CanonicalCoordinatorState {
+		return this.#state;
+	}
+
+	/** Reservations this owner still holds, including one retained by an unresolved commit. */
+	get retainedReservations(): readonly string[] {
+		return [...this.#reservations.keys()];
+	}
+
+	/** The registered host's canonical trio, or undefined when canonical behaviour is unmanaged. */
+	get host(): NativeCanonicalHost | undefined {
+		return nativeSubmissionBarrier.canonicalHost;
+	}
+
+	get managed(): boolean {
+		return this.host !== undefined;
+	}
+
+	/**
+	 * A different owner is a different lifetime: no reservation, adoption or uncertainty carries over. The
+	 * same owner re-registering its host (a resource reload) keeps all of it, exactly as seam A does.
+	 */
+	#syncOwner(host: NativeCanonicalHost | undefined): void {
+		const ownerRunId = nativeSubmissionBarrier.ownerRunId;
+		if (host === undefined || ownerRunId === this.#ownerRunId) return;
+		this.#ownerRunId = ownerRunId;
+		this.#reservations.clear();
+		this.#operationIds.clear();
+		this.#startupAdoption = undefined;
+		this.#setState("READY");
+	}
+
+	#setState(state: CanonicalCoordinatorState): void {
+		this.#state = state;
+		// Seam A shares the fail-closed state: a fence granted before uncertainty is refused explicitly
+		// rather than mislabelled stale or duplicate.
+		nativeSubmissionBarrier.setCanonicalPersistenceUnresolved(state !== "READY");
+	}
+
+	/**
+	 * Adopt the binding this owner already holds.
+	 *
+	 * This is **not** the startup reservation a managed launch needs. An extension registers long after the
+	 * initial `SessionManager` was constructed, so the authoritative pre-spawn reservation belongs to the
+	 * worker that spawns Pi; once a host is registered, this records the already-known binding with the host
+	 * before any later protected operation. Nothing here proves startup ordering.
+	 */
+	async #adoptStartupBinding(
+		host: NativeCanonicalHost,
+	): Promise<{ ok: false; code: CanonicalOperationRefusalCode; message: string } | undefined> {
+		// Memoized per owner: two concurrent operations adopt once between them, not twice.
+		if (!this.#startupAdoption) {
+			const binding = nativeSubmissionBarrier.binding;
+			if (binding.canonicalFile === undefined) return undefined;
+			this.#startupAdoption = this.#run(host, {
+				operation: "startup",
+				resolvedTarget: binding.canonicalFile,
+				mutate: () => undefined,
+			}).then((adopted) => {
+				if (adopted.ok) return undefined;
+				this.#startupAdoption = undefined;
+				return { ok: false as const, code: adopted.code, message: adopted.message };
+			});
+		}
+		return this.#startupAdoption;
+	}
+
+	async run<T>(request: CanonicalOperationRequest<T>): Promise<CanonicalOperationResult<T>> {
+		const host = this.host;
+		this.#syncOwner(host);
+		if (!host) {
+			// Unmanaged: exactly the mutation stock Pi performs, in the order it performs it, and exactly the
+			// error it throws. The not-performed marker is a managed classification only, so it is unwrapped here.
+			let value: T;
+			try {
+				value = request.mutate();
+			} catch (error) {
+				throw error instanceof CanonicalMutationNotPerformedError ? error.cause : error;
+			}
+			await request.rebind?.(value);
+			return { ok: true, managed: false, value, reservationId: undefined, nextGeneration: undefined };
+		}
+		if (this.#state !== "READY") return this.#unresolved();
+		if (request.operation !== "startup") {
+			const blocked = await this.#adoptStartupBinding(host);
+			if (blocked) return { ok: false, code: blocked.code, message: blocked.message };
+		}
+		return this.#run(host, request);
+	}
+
+	/** The fail-closed refusal, with the reason this owner is not `READY`. */
+	#unresolved(): { ok: false; code: "PERSISTENCE_UNCERTAIN"; message: string } {
+		return {
+			ok: false,
+			code: "PERSISTENCE_UNCERTAIN",
+			message:
+				this.#state === "COMMIT_PENDING"
+					? "a canonical commit is still pending; this operation performed nothing"
+					: "this owner's canonical persistence is unresolved; recovery is an explicit host action",
+		};
+	}
+
+	async #run<T>(host: NativeCanonicalHost, request: CanonicalOperationRequest<T>): Promise<CanonicalOperationResult<T>> {
+		const operationId = `${nativeSubmissionBarrier.ownerRunId ?? "owner"}:${request.operation}:${randomUUID()}`;
+		const operation: CanonicalOperation = {
