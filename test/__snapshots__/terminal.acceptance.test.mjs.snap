// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`pins the complete list and viewer surfaces at 40x10 1`] = `
{
  "list": [
    " pi-agents                              ",
    "╭─ Sessions ────────────────────────────",
    "  NAME       STATE    ACTIVITY          ",
    "⠋ 検証 🚀 r… WORKING  bash: pytest 検…  ",
    "  waiting    WAITING  Approval needed   ",
    "                                        ",
    "────────────────────────────────────────",
    " ❯ describe a task for a new session    ",
    "────────────────────────────────────────",
    " cwd:/repo isolation:worktree model:/ na",
  ],
  "viewer": [
    " WAITING/LIVE",
    "                                        ",
    "    ────────────────────────────────    ",
    "     Continue?                          ",
    " ⠋ W y/Enter confirm · n/Escape         ",
    "──── cancel                         ────",
    ">   ────────────────────────────────    ",
    "────────────────────────────────────────",
    "                 (anthropic) opus • high",
    " escape/← list · pageUp/pageDown scroll",
  ],
}
`;

