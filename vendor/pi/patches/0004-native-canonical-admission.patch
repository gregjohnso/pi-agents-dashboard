+		let mutations = 0;
+		const second = await runCanonicalOperation({
+			operation: "delete",
+			resolvedTarget: join(workspace, "other.jsonl"),
+			rebinds: false,
+			mutate: () => ++mutations,
+		});
+		expect(second).toMatchObject({ ok: false, code: "PERSISTENCE_UNCERTAIN" });
+		expect(mutations).toBe(0);
+
+		const grant = await nativeSubmissionBarrier.begin({
+			source: "native-editor",
+			intent: "prompt",
+			originalText: "blocked",
+			behavior: "idle",
