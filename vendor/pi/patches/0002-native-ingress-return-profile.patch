index 0000000000000000000000000000000000000000..ade233d43113540f02396eb54e432be0b99c4b1f
--- /dev/null
+++ b/packages/tui/src/native-attachment.ts
@@ -0,0 +1,341 @@
+/**
+ * Native attachment seams B, C and F.
+ *
+ * A host process can own the terminal that Pi renders into and let more than one authenticated client
+ * type into it. That needs three things Pi alone cannot supply: which client a byte span came from,
+ * whether a return key belongs to the focused component or to the host, and whether a terminal response
+ * from an unauthenticated byte stream may change Pi's negotiated capability state.
+ *
+ * This module is interfaces and one process-wide registration. It holds no attachment registry, no
+ * ownership policy and no session state: Pi never learns who is attached, only which epoch a byte span
+ * claimed. Unmanaged Pi registers nothing and every path here is skipped.
+ */
+
+/**
+ * Identity of one client attachment. `epoch` strictly increases per `attachmentId` and is never reused,
+ * so a reconnect is a new epoch and a reply from a previous connection is recognisably stale.
+ */
+export type AttachmentEpoch = { attachmentId: string; epoch: number };
+
+/**
+ * Provenance of one parsed input sequence, carried alongside the bytes through the whole native path.
+ *
+ * `origin` is the attachment that supplied the sequence's **final** byte. `mixedOrigin` records that at
+ * least one earlier byte of the same sequence came from a different attachment. Origin describes the
+ * gesture, never authorship of the shared draft.
+ */
+export type NativeInputProvenance = {
+	/** Minted per delivered sequence by the terminal, so a decision can name the exact sequence. */
+	sequenceId: string;
+	/** `null` for ordinary local stdin: unmanaged Pi has no attachment identity. */
+	origin: AttachmentEpoch | null;
+	mixedOrigin: boolean;
+	/**
+	 * The binding generation the sequence's own **final** byte was dispatched under; `0` for local stdin.
+	 * This is the generation of the bytes, not whichever generation the terminal has since reached.
+	 */
+	bindingGeneration: number;
+	/**
+	 * Native framing assembled this sequence from bytes dispatched under more than one binding
+	 * generation, so stale-generation bytes helped form it. Such a sequence never authorizes a return.
+	 */
+	mixedBindingGeneration: boolean;
+};
+
+export type TerminalResponseKind = "da" | "kitty-keyboard" | "cell-size" | "other";
+
+/**
+ * A complete terminal response that native parsing has classified and is about to apply. The host
+ * decides before any capability state moves, not after.
+ */
+export type TerminalResponseApplication = {
+	kind: TerminalResponseKind;
+	/** Increments on every capability query Pi writes, so a reply to a superseded query is detectable. */
+	requestEpoch: number;
+	/** The attachment whose bytes completed the response; `null` for local stdin. */
+	attachmentEpoch: AttachmentEpoch | null;
+	raw: Uint8Array;
+};
+
+/**
+ * The terminal Pi believes it is talking to. Fixed by the owner at launch: Pi negotiates once, and a
+ * client that attaches later missed that exchange, so it can never change the profile.
+ */
+export type VirtualTerminalProfile = {
+	profileId: string;
+	term: string;
+	capabilities: {
+		kittyKeyboard: boolean;
+		kittyGraphics: boolean;
+		mouse: boolean;
+		bracketedPaste: boolean;
+		synchronizedOutput: boolean;
+		trueColor: boolean;
+	};
+	cellSize: { width: number; height: number } | null;
+};
+
+export type NativeReturnRequest = {
+	sequenceId: string;
+	origin: AttachmentEpoch;
+	mixedOrigin: boolean;
+	binding: { generation: number };
+};
+
+/** `'native'` means deliver the key to the focused component. Anything else is the host's own action. */
+export type ReturnAuthorization = "native" | { detachOrigin: AttachmentEpoch };
+
+/**
+ * Implemented by a component that knows a return key is not its own. Absent means `'owns'`: an unknown
+ * or custom component keeps the key and the host is never asked.
+ */
+export interface ReturnDisposition {
+	declaresReturnKey(sequence: string): "owns" | "free";
+}
+
+export function declaresReturnKey(component: unknown, sequence: string): "owns" | "free" {
+	if (component === null || typeof component !== "object") return "owns";
+	const declare = (component as Partial<ReturnDisposition>).declaresReturnKey;
+	if (typeof declare !== "function") return "owns";
+	return declare.call(component, sequence) === "free" ? "free" : "owns";
+}
+
+export interface NativeAttachmentHost {
+	/** Launch-fixed; the first registration decides it and a later differing profile is refused. */
+	profile: VirtualTerminalProfile;
+
+	/**
+	 * Evaluated synchronously inside the native input turn, after focus and overlay resolution. Called
+	 * only for a single-origin return that the focused component has declared free.
+	 */
+	authorizeReturn(request: NativeReturnRequest): ReturnAuthorization;
+
+	/**
+	 * Awaited before the response changes any capability state. A rejection, a throw, a timeout or an
+	 * epoch that moved while awaiting all mean: consume the response, change nothing.
+	 */
+	beforeApplyTerminalResponse(response: TerminalResponseApplication): Promise<{ apply: boolean }>;
+}
+
+export type NativeAttachmentRegistration = { release(): void };
+
+/**
+ * How long a managed host has to authorize one classified terminal response. Expiry is a refusal: the
+ * response is consumed and no capability state moves. Every response kind uses this one bound, so a
+ * never-settling host cannot apply late and cannot defeat the drain boundary.
+ */
+const RESPONSE_AUTHORIZATION_TIMEOUT_MS = 1000;
+
+/**
+ * The registry is one host per process, and a process can hold more than one copy of this module: a
+ * bundled Pi inlines `@earendil-works/pi-tui`, so the owner's bootstrap importing the installed package
+ * and the CLI running from the bundle are two module instances. State kept in module scope would split
+ * in exactly that case — the bootstrap would register a host the bundle never sees — so it lives in one
+ * container on `globalThis` that whichever instance loads first creates and both then use.
+ *
+ * Scope is this process only. A worker thread, a child process or another realm has its own `globalThis`
+ * and therefore its own registry; nothing here crosses a process boundary and this is not a security or
+ * isolation boundary against trusted extension code.
+ *
+ * Compatibility rule: the key is unversioned and the container carries `version`. A copy of this module
+ * that understands a different version refuses to use the container rather than replacing, resetting or
+ * silently falling back to unmanaged behavior — mixing two schemas would corrupt one host's launch
+ * profile or epoch bookkeeping. Bump `NATIVE_ATTACHMENT_STATE_VERSION` only for an incompatible change
+ * to the fields below.
+ */
+const NATIVE_ATTACHMENT_STATE_KEY = Symbol.for("@earendil-works/pi-tui:native-attachment");
+const NATIVE_ATTACHMENT_STATE_VERSION = 1;
+
+type NativeAttachmentState = {
+	version: number;
+	host: NativeAttachmentHost | undefined;
+	launchProfile: VirtualTerminalProfile | undefined;
+	/**
+	 * Highest epoch seen per attachment. Response authorization has to know whether the attachment that
+	 * completed a reply has since been replaced, and the terminal and the TUI both need that answer.
+	 */
+	highestEpochByAttachment: Map<string, number>;
+	/** Every in-flight response authorization, whatever started it. `dispatchNativeInput` drains this. */
+	pendingAuthorizations: Set<Promise<void>>;
+};
+
+function isUsableState(candidate: unknown): candidate is NativeAttachmentState {
+	if (candidate === null || typeof candidate !== "object") return false;
+	const state = candidate as Partial<NativeAttachmentState>;
+	return (
+		state.version === NATIVE_ATTACHMENT_STATE_VERSION &&
+		state.highestEpochByAttachment instanceof Map &&
+		state.pendingAuthorizations instanceof Set
+	);
+}
+
+/**
+ * The process-wide container, created once. Private to this module: every caller, in either module
+ * instance, goes through the exported functions rather than touching the global object.
+ */
+function nativeAttachmentState(): NativeAttachmentState {
+	const container = globalThis as unknown as Record<symbol, unknown>;
+	const existing = container[NATIVE_ATTACHMENT_STATE_KEY];
+	if (existing !== undefined) {
+		if (!isUsableState(existing)) {
+			const found =
+				existing !== null && typeof existing === "object"
+					? `version ${String((existing as { version?: unknown }).version)}`
+					: `a ${typeof existing}`;
+			throw new Error(
+				`the native attachment registry in this process is ${found}, and this copy of ` +
+					`@earendil-works/pi-tui speaks version ${NATIVE_ATTACHMENT_STATE_VERSION}. Load one ` +
+					`compatible pi-tui version per process; the registry is never replaced or reset.`,
+			);
+		}
+		return existing;
+	}
+	const created: NativeAttachmentState = {
+		version: NATIVE_ATTACHMENT_STATE_VERSION,
+		host: undefined,
+		launchProfile: undefined,
+		highestEpochByAttachment: new Map<string, number>(),
+		pendingAuthorizations: new Set<Promise<void>>(),
+	};
+	Object.defineProperty(globalThis, NATIVE_ATTACHMENT_STATE_KEY, {
+		value: created,
+		writable: false,
+		configurable: false,
+		enumerable: false,
+	});
+	return created;
+}
+
+/**
+ * Record that this attachment epoch is now the current one for its attachment id.
+ *
+ * Internal to the package, and called from admission in `dispatchNativeInput` before that dispatch waits
+ * for its turn, so a reconnect is visible to an authorization that is already awaiting a host decision.
+ * The owner needs no out-of-band reconnect notification and there is no public mutator for this.
+ */
+export function noteAttachmentEpoch(attachmentEpoch: AttachmentEpoch): void {
+	const { highestEpochByAttachment } = nativeAttachmentState();
+	const seen = highestEpochByAttachment.get(attachmentEpoch.attachmentId);
+	if (seen === undefined || attachmentEpoch.epoch > seen) {
+		highestEpochByAttachment.set(attachmentEpoch.attachmentId, attachmentEpoch.epoch);
+	}
+}
+
+export function isSupersededAttachmentEpoch(attachmentEpoch: AttachmentEpoch | null): boolean {
+	if (!attachmentEpoch) return false;
+	const seen = nativeAttachmentState().highestEpochByAttachment.get(attachmentEpoch.attachmentId);
+	return seen !== undefined && attachmentEpoch.epoch < seen;
+}
+
+function withTimeout<T>(decision: Promise<T>): Promise<T> {
+	return new Promise<T>((resolve, reject) => {
+		const timer = setTimeout(() => {
+			reject(new Error("terminal response authorization expired"));
+		}, RESPONSE_AUTHORIZATION_TIMEOUT_MS);
+		timer.unref?.();
+		decision.then(
+			(value) => {
+				clearTimeout(timer);
+				resolve(value);
+			},
+			(error) => {
+				clearTimeout(timer);
+				reject(error);
+			},
+		);
+	});
+}
+
+/**
+ * Ask the host, then apply only if it said yes **and** the request is still the current one **and** the
+ * attachment that answered has not been superseded. `stillCurrent` is re-evaluated after the await, not
+ * before it, because the point of the seam is that state can move while the host is deciding.
+ *
+ * A refusal, a throw, a rejection or an expiry all mean: the response was consumed, nothing was applied.
+ */
+export function authorizeTerminalResponse(
+	host: NativeAttachmentHost,
+	response: TerminalResponseApplication,
+	stillCurrent: () => boolean,
+	apply: () => void,
+): Promise<void> {
+	const authorization = (async () => {
+		let permitted = false;
+		try {
+			const decision = await withTimeout(host.beforeApplyTerminalResponse(response));
+			permitted = decision?.apply === true;
+		} catch {
+			permitted = false;
+		}
+		if (!permitted) return;
+		if (!stillCurrent()) return;
+		if (isSupersededAttachmentEpoch(response.attachmentEpoch)) return;
+		apply();
+	})();
+	const { pendingAuthorizations } = nativeAttachmentState();
+	pendingAuthorizations.add(authorization);
+	void authorization.finally(() => {
+		pendingAuthorizations.delete(authorization);
+	});
+	return authorization;
+}
+
+/** Settle every in-flight response authorization. This is the drain boundary seam G refers to. */
+export async function settleTerminalResponseAuthorizations(): Promise<void> {
+	const { pendingAuthorizations } = nativeAttachmentState();
+	while (pendingAuthorizations.size > 0) {
+		await Promise.allSettled([...pendingAuthorizations]);
+	}
+}
+
+function freezeProfile(profile: VirtualTerminalProfile): VirtualTerminalProfile {
+	return Object.freeze({
+		profileId: profile.profileId,
+		term: profile.term,
+		capabilities: Object.freeze({ ...profile.capabilities }),
+		cellSize: profile.cellSize ? Object.freeze({ ...profile.cellSize }) : null,
+	});
+}
+
+function sameProfile(a: VirtualTerminalProfile, b: VirtualTerminalProfile): boolean {
+	return JSON.stringify(freezeProfile(a)) === JSON.stringify(freezeProfile(b));
+}
+
+/**
+ * The supported registration entry point, for the owner's core bootstrap, before Pi writes its startup
+ * capability queries — so the authorization path never sits behind arbitrary extension initialisation.
+ *
+ * Registration and the launch profile are process-wide, so a caller that imported a second copy of this
+ * module (the installed package alongside a bundled Pi) registers the same host the bundle consults, and
+ * the profile stays fixed for the whole launch across both copies.
+ */
+export function registerNativeAttachmentHost(host: NativeAttachmentHost): NativeAttachmentRegistration {
+	const state = nativeAttachmentState();
+	if (state.launchProfile && !sameProfile(state.launchProfile, host.profile)) {
+		throw new Error(
+			`the virtual terminal profile is fixed at launch (${state.launchProfile.profileId}); ` +
+				`refusing to replace it with ${host.profile.profileId}`,
+		);
+	}
+	if (!state.launchProfile) {
+		state.launchProfile = freezeProfile(host.profile);
+	}
+	state.host = host;
+	const registration = {
+		/** Clears this host only: a stale handle never clears a replacement registration. */
+		release(): void {
+			const current = nativeAttachmentState();
+			if (current.host === host) current.host = undefined;
+		},
+	};
+	return registration;
+}
+
+export function getNativeAttachmentHost(): NativeAttachmentHost | undefined {
+	return nativeAttachmentState().host;
+}
+
+/** The launch-fixed profile. Survives `release()`: a detaching host does not reopen the negotiation. */
+export function getVirtualTerminalProfile(): VirtualTerminalProfile | undefined {
+	return nativeAttachmentState().launchProfile;
+}
