+/** The codec name a capability declaration carries, so a peer matches on a name rather than a shape. */
+export const NATIVE_PRESENT_MARKER_CODEC = "dcs-pi-native-present-v1";
+
+/** The ordering version this build speaks. An unknown version is refused before anything is written. */
+export const NATIVE_PRESENT_ORDERING_VERSION = 1;
+
