+ * `pi.setNativeSubmissionHost` again for the same owner.
+ */
+async function reloadableExtensionLoader(factory: Parameters<typeof createTestExtensionsResult>[0][number], dir: string) {
+	const reloads = { count: 0 };
+	let extensionsResult = await createTestExtensionsResult([factory], dir);
+	const loader = {
+		...baseLoader(),
+		getExtensions: () => extensionsResult,
+		reload: async () => {
+			extensionsResult = await createTestExtensionsResult([factory], dir);
+			reloads.count++;
+		},
+	} as never;
+	return { loader, reloads };
+}
+
+function baseLoader() {
+	return {
+		getExtensions: () => ({ extensions: [], errors: [], runtime: createExtensionRuntime() }),
+		getSkills: () => ({ skills: [], diagnostics: [] }),
+		getPrompts: () => ({ prompts: [], diagnostics: [] }),
+		getThemes: () => ({ themes: [], diagnostics: [] }),
+		getAgentsFiles: () => ({ agentsFiles: [] }),
+		getSystemPrompt: () => undefined,
+		getSystemPromptSource: () => undefined,
+		getAppendSystemPrompt: () => [],
+		getAppendSystemPromptSources: () => [],
+		extendResources: () => {},
+		reload: async () => {},
+	};
+}
+
+/**
+ * A real legacy editor component: the extension-provided shape that predates the barrier. It implements
+ * `EditorComponent`'s required surface and none of its optional hooks, destroys its own state before it
+ * tells the application anything, and can deliver that call asynchronously.
+ */
+class LegacyEditorComponent {
+	text = "";
+	/** Component-private state Pi neither reads nor reconstructs. */
+	readonly privateState: string[] = [];
+	/** Every public call Pi made on this component, so recovery can be shown to be text-only. */
+	readonly calls: string[] = [];
+	deliver: (submit: () => void) => void = (submit) => submit();
+	onSubmit?: (text: string) => void;
+	onChange?: (text: string) => void;
+
+	getText(): string {
+		this.calls.push("getText");
+		return this.text;
+	}
+	setText(text: string): void {
+		this.calls.push(`setText(${JSON.stringify(text)})`);
+		this.text = text;
+	}
+	handleInput(data: string): void {
+		if (data !== "\r") {
+			this.text += data;
+			this.privateState.push(`typed:${data}`);
+			return;
+		}
+		const submitted = this.text;
+		// The legacy order: clear the component's own screen first, then tell the application.
+		this.text = "";
+		this.privateState.push("self-cleared");
+		this.deliver(() => this.onSubmit?.(submitted));
+	}
+	render(): string[] {
+		return [this.text];
+	}
+}
+
+/**
+ * A custom editor that adopts the optional hooks: it asks the gate, retains the whole draft until the
+ * revision-bound commit, and therefore keeps full preservation.
+ */
+class CooperatingEditorComponent {
+	text = "";
+	draftRevision = 0;
+	readonly committed: number[] = [];
+	onSubmit?: (text: string) => void;
+	onChange?: (text: string) => void;
+	submitGate?: (submission: { text: string; originalText: string; draftRevision: number }) => boolean | Promise<boolean>;
+
+	getText(): string {
+		return this.text;
+	}
+	setText(text: string): void {
+		this.text = text;
+		this.draftRevision++;
+	}
+	commitSubmittedDraft(revision: number): boolean {
+		this.committed.push(revision);
+		if (revision !== this.draftRevision) return false;
+		this.text = "";
+		this.draftRevision++;
+		return true;
+	}
+	async handleInput(data: string): Promise<void> {
+		if (data !== "\r") {
+			this.text += data;
+			this.draftRevision++;
+			return;
+		}
+		const submitted = this.text;
+		const granted =
+			(await this.submitGate?.({
+				text: submitted.trim(),
+				originalText: submitted,
+				draftRevision: this.draftRevision,
+			})) ?? true;
+		if (!granted) return;
+		this.onSubmit?.(submitted);
+	}
+	render(): string[] {
+		return [this.text];
+	}
+}
+
+/**
+ * A real `InteractiveMode` submit handler over a real `AgentSession` and a real `Editor`.
+ *
+ * `interactive-tui.test.ts` establishes this pattern upstream: build the instance from the prototype so
+ * the actual private methods run without standing up a full startup path. Every collaborator the seam
+ * touches — the editor, the session, the compaction queue — is the real one.
+ */
+function interactiveHarness(harness: Harness) {
+	const editor = new Editor(editorHost(), editorTheme);
+	const status: string[] = [];
+	const warnings: string[] = [];
+	const errors: string[] = [];
+	const mode = Object.assign(Object.create(InteractiveMode.prototype), {
+		defaultEditor: editor,
+		editor,
+		// `session` and `sessionManager` are getters over the runtime host, so the host is what we provide.
+		runtimeHost: { session: harness.session },
+		ui: { requestRender() {}, setFocus() {} },
+		editorContainer: { clear() {}, addChild() {} },
+		compactionQueuedMessages: [],
+		pendingUserInputs: [],
+		pendingUserInputTickets: [],
+		pendingBashComponents: [],
+		isBashMode: false,
+		keybindings: { getEffectiveConfig: () => ({}) },
+		showSettingsSelector: () => status.push("settings-selector"),
+		showStatus: (message: string) => status.push(message),
+		showError: (message: string) => errors.push(message),
+		showWarning: (message: string) => warnings.push(message),
+		updatePendingMessagesDisplay: () => {},
+		flushPendingBashComponents: () => {},
+		updateEditorBorderColor: () => {},
+		disposeActiveSelector: () => {},
+	}) as InteractiveMode & {
+		compactionQueuedMessages: Array<{ text: string; mode: string; submissionId?: string; handoff?: string }>;
+		pendingUserInputs: string[];
+		getUserInput(): Promise<string>;
+	};
+	const prototype = InteractiveMode.prototype as unknown as {
+		setupEditorSubmitHandler(this: unknown): void;
+		setCustomEditorComponent(this: unknown, factory: (() => unknown) | undefined): void;
+		flushCompactionQueue(this: unknown, options?: { willRetry?: boolean }): Promise<void>;
+		takeNativeSubmitForCurrentInput(this: unknown): { nativeSubmit: { handoff: string; originalText: string } } | undefined;
+		handleFollowUp(this: unknown): Promise<void>;
+	};
+	prototype.setupEditorSubmitHandler.call(mode);
+	return { mode, editor, prototype, status, warnings, errors };
