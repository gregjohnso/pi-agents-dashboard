+/**
+ * Seam G: the one child-terminal handoff Pi already recognizes.
+ *
+ * Pi's external editor takes this terminal for the length of an edit. Locally that is already modelled:
+ * seam E marks a recognized release, so a cold presentation refuses instead of painting over the child. A
+ * host that feeds Pi labelled bytes needs two more things around it — a boundary after which none of its
+ * clients' bytes enter Pi's parser, and a paired announcement of the transition.
+ *
+ * This module is that bracket and nothing else. It spawns nothing, parses nothing and knows nothing about
+ * editors: the caller supplies the child to run and the four terminal operations. With no registered host,
+ * or a host that has not opted into this build's seam G version, it runs exactly the sequence Pi ran before.
+ *
+ * Arbitrary extension children are still not covered, and a phase listener returning is local notification,
+ * never a host's acknowledgement that it changed its input route.
+ */
+
+import {
+	isChildTerminalHandoffActive,
+	type NativeInputDrainLease,
+	nextChildTerminalPhaseId,
+	notifyChildTerminalPhase,
+	type Terminal,
+} from "@earendil-works/pi-tui";
+
+/**
+ * One recognized handoff site. `T` is whatever the child produces; this module never inspects it.
+ *
+ * `stop` and `restore` are Pi's own renderer operations, in the caller's vocabulary: `restore` is the
+ * restoration *attempt*, and a throw from it means Pi did not get its terminal back cleanly.
+ */
+export type ChildTerminalHandoffSite<T> = {
+	/** The terminal the child inherits. Its drain is what makes a managed handoff possible. */
+	terminal: Terminal;
+	/** Seam E's recognized release, read live: a second managed handoff is refused while one is active. */
+	isReleased(): boolean;
+	release(): void;
+	reclaim(): void;
+	stop(): void;
+	restore(): void;
+	runChild(): Promise<T>;
+	/**
+	 * Apply the child's result and say what it was. This module never inspects `T`, so the site is the only
+	 * thing that knows whether a *resolved* result is a success: Pi's external editor resolves
+	 * `{ status: "failed" }` for a spawn error, a signal or a nonzero exit rather than rejecting, and a site
+	 * that applied nothing must report `failed` instead of letting the bracket announce a return.
+	 */
+	applyResult(result: T): "returned" | "failed";
+};
+
+export type ChildTerminalHandoffReport =
+	/** The child ran with no drain and no phase bracket: this is Pi's pinned path. */
+	| { entered: true; managed: false }
+	/** The child ran inside the drain and the announced bracket. */
+	| { entered: true; managed: true; childPhaseId: string; drainedThrough: number; outcome: "returned" | "failed" }
+	/** A recognized release was already active: nothing was drained, announced, stopped or spawned. */
+	| { entered: false; refusal: "already-released" };
+
+function drainOf(terminal: Terminal): (() => Promise<NativeInputDrainLease>) | undefined {
+	const drain = terminal.drainNativeInput;
+	return typeof drain === "function" ? () => drain.call(terminal) : undefined;
+}
+
+/**
+ * Run one recognized child-terminal handoff.
+ *
+ * Managed order: drain to a boundary, mark seam E's recognized release, announce `entering`, stop the
+ * renderer, run the child. Then, in an outermost finalizer chain: attempt restoration, clear the release
+ * only after that attempt, announce exactly one matching `left`, and reopen admission last, so a listener,
+ * spawn, child, stop, start or render failure cannot strand the gate closed.
+ *
+ * `outcome` is the site's own classification of the resolved result, downgraded to `failed` when restoration
+ * throws. A child that resolved a failure and a return Pi could not restore itself from are both `failed`:
+ * Pi never advertises a return that did not happen.
+ *
+ * The child's own failure still propagates to the caller, exactly as it does in the pinned path.
+ */
+export async function bracketRecognizedChildTerminal<T>(
+	site: ChildTerminalHandoffSite<T>,
+): Promise<ChildTerminalHandoffReport> {
+	const drain = drainOf(site.terminal);
+	if (!isChildTerminalHandoffActive() || !drain) {
+		site.release();
+		site.stop();
+		try {
+			site.applyResult(await site.runChild());
+		} finally {
+			site.reclaim();
+			site.restore();
+		}
+		return { entered: true, managed: false };
+	}
+
+	if (site.isReleased()) return { entered: false, refusal: "already-released" };
+
+	// Awaited before anything is announced or spawned: the child starts only once every byte admitted
+	// before the barrier has been through Pi's parser and every response authorization has settled.
+	const lease = await drain();
+	site.release();
+	const childPhaseId = nextChildTerminalPhaseId();
+	let outcome: "returned" | "failed" = "failed";
+	try {
+		notifyChildTerminalPhase({
+			phase: "entering",
+			childPhaseId,
+			reason: "external-editor",
+			drainedThrough: lease.drainedThrough,
+		});
+		site.stop();
+		outcome = site.applyResult(await site.runChild());
+	} finally {
+		try {
+			try {
+				site.restore();
+			} catch (error) {
+				outcome = "failed";
+				throw error;
+			} finally {
+				site.reclaim();
+				notifyChildTerminalPhase({ phase: "left", childPhaseId, reason: "external-editor", outcome });
+			}
+		} finally {
+			lease.reopen();
+		}
+	}
+	return { entered: true, managed: true, childPhaseId, drainedThrough: lease.drainedThrough, outcome };
+}
