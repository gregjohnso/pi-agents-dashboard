+describe("core bootstrap sideband", () => {
+	/**
+	 * One host-side listener. Every wait resolves from a frame or rejects on its own bound; nothing polls.
+	 *
+	 * The socket lives in a short directory of its own rather than under `TMPDIR`. Measured on worker 3739922:
+	 * in this same process, binding a 179-byte path under a run's `TMPDIR` succeeded while a 184-byte one on
+	 * the same filesystem failed with `EADDRINUSE` on a path that did not exist, and a 39-byte path under the
+	 * machine's own `/tmp` succeeded. A socket is a transport, not an output, so it is created here and removed
+	 * with the listener.
+	 */
+	async function hostListener() {
+		const directory = await mkdtemp("/tmp/pi-native-bootstrap-");
+		const socketPath = join(directory, "s");
+		const frames: Record<string, any>[] = [];
+		let waiting: ((frame: Record<string, any>) => void) | undefined;
+		let peer: net.Socket | undefined;
+		let buffered = "";
+		// `allowHalfOpen` keeps this peer writable after Pi's own FIN, which is what makes a post-breach write
+		// observable at all: Pi refuses the frame, half-closes, and the case still sends one more command to
+		// prove nothing reads it. A default server would auto-end here and the command would never leave.
+		const server = net.createServer({ allowHalfOpen: true }, (connection) => {
+			peer = connection;
+			connection.setEncoding("utf8");
+			connection.on("error", () => {});
+			connection.on("data", (chunk: string) => {
+				buffered += chunk;
+				let newline = buffered.indexOf("\n");
+				while (newline !== -1) {
+					const line = buffered.slice(0, newline);
+					buffered = buffered.slice(newline + 1);
+					if (line.trim()) {
+						const frame = JSON.parse(line) as Record<string, any>;
+						frames.push(frame);
+						waiting?.(frame);
+						waiting = undefined;
+					}
+					newline = buffered.indexOf("\n");
+				}
+			});
+		});
+		await new Promise<void>((resolve) => server.listen(socketPath, () => resolve()));
+		return {
+			socketPath,
+			frames,
+			/**
+			 * The next frame, or a rejection naming what never came. The bound belongs here rather than in the
+			 * runner's own timeout, so a channel that answers nothing says so instead of timing the case out.
+			 */
+			next: (label = "a frame", timeoutMs = 10_000) =>
+				new Promise<Record<string, any>>((resolve, reject) => {
+					const timer = setTimeout(() => {
+						waiting = undefined;
+						reject(new Error(`${label} never arrived within ${timeoutMs}ms; frames so far: ${JSON.stringify(frames)}`));
+					}, timeoutMs);
+					waiting = (frame) => {
+						clearTimeout(timer);
+						resolve(frame);
+					};
+				}),
+			send: (command: unknown) => peer?.write(`${JSON.stringify(command)}\n`),
+			/** Bytes exactly as given: a frame bound and a parse refusal are not reachable through `send`. */
+			sendRaw: (bytes: string) => peer?.write(bytes),
+			async close() {
+				peer?.destroy();
+				await new Promise<void>((resolve) => server.close(() => resolve()));
+				await rm(directory, { recursive: true, force: true });
+			},
+		};
+	}
