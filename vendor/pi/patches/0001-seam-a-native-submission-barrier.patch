@@ -0,0 +1,1518 @@
+/**
+ * Seam A regression test: the native submission barrier.
+ *
+ * Exercises real Pi code against a faithful fake durable host: the barrier, `AgentSession`, the TUI
+ * `Editor`'s submit gate, and — through the upstream harness and `InteractiveMode.prototype` — the real
+ * interactive insertion points for built-in commands, extension commands and the compaction pre-queue.
+ *
+ * The fake host stands in for pi-agents' worker-side ledger. It is not that ledger and proves nothing
+ * about durability.
+ */
+
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { Editor, type EditorTheme } from "@earendil-works/pi-tui";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import {
+	type EffectivePayloadRecord,
+	nativeSubmissionBarrier,
+	NativeSubmissionRefusedError,
+	type NativeSubmitAuthorization,
+	type NativeSubmitHost,
+	type NativeSubmitOutcome,
+	setNativeSubmissionHost,
+	type SubmissionEnvelope,
+} from "../src/core/native-submission.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { createSyntheticSourceInfo } from "../src/core/source-info.ts";
+import { createExtensionRuntime } from "../src/core/extensions/index.ts";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+import { createHarness, createHarnessWithExtensions, type Harness } from "./test-harness.ts";
+import { createTestExtensionsResult } from "./utilities.ts";
+
+const OWNER = "owner-run-1";
+
+/** A faithful fake of the host's obligations. Records only; it is not a durable ledger. */
+class FakeDurableHost implements NativeSubmitHost {
+	ownerRunId = OWNER;
+	readonly envelopes: SubmissionEnvelope[] = [];
+	readonly payloads: EffectivePayloadRecord[] = [];
+	readonly outcomes: NativeSubmitOutcome[] = [];
+	decide: (envelope: SubmissionEnvelope) => Promise<NativeSubmitAuthorization> = async (envelope) => grant(envelope);
+	record: (payload: EffectivePayloadRecord) => Promise<{ recorded: true } | { recorded: false; code: string; reason: string }> =
+		async () => ({ recorded: true });
+
+	async beforeNativeSubmit(envelope: SubmissionEnvelope) {
+		this.envelopes.push(envelope);
+		return this.decide(envelope);
+	}
+	async recordEffectivePayload(payload: EffectivePayloadRecord) {
+		this.payloads.push(payload);
+		return this.record(payload);
+	}
+	nativeSubmitOutcome(outcome: NativeSubmitOutcome) {
+		this.outcomes.push(outcome);
+	}
+	appliedAs(): string[] {
+		return this.outcomes.map((outcome) => outcome.appliedAs);
+	}
+}
+
+function grant(envelope: SubmissionEnvelope): NativeSubmitAuthorization {
+	return {
+		authorized: true,
+		fence: {
+			submissionId: envelope.submissionId,
+			ownerRunId: OWNER,
+			bindingGeneration: envelope.binding.generation,
+			nonce: `nonce-${envelope.submissionId}`,
+		},
+	};
+}
+
+const editorTheme: EditorTheme = {
+	borderColor: (text: string) => text,
+	selectList: {
+		selectedPrefix: (text: string) => text,
+		selectedText: (text: string) => text,
+		description: (text: string) => text,
+		scrollInfo: (text: string) => text,
+		noMatch: (text: string) => text,
+	},
+};
+
+// The Editor uses exactly two things from its TUI: a render request and the terminal row count.
+function editorHost() {
+	return { requestRender() {}, terminal: { rows: 24, columns: 80 } } as never;
+}
+
+/** A resource loader whose only prompt template is `/tmpl`. */
+function loaderWithTemplate() {
+	const template = {
+		name: "tmpl",
+		description: "a template",
+		content: "expanded template body",
+		sourceInfo: createSyntheticSourceInfo("/tmp/tmpl.md", { source: "test" }),
+		filePath: "/tmp/tmpl.md",
+	};
+	return { ...baseLoader(), getPrompts: () => ({ prompts: [template], diagnostics: [] }) } as never;
+}
+
+/** A resource loader with one real skill file on disk, because skill expansion reads it. */
+function loaderWithSkill() {
+	const dir = mkdtempSync(join(tmpdir(), "pi-seam-a-skill-"));
+	const filePath = join(dir, "probe.md");
+	writeFileSync(filePath, "skill body for the probe\n");
+	const skill = { name: "probe", description: "a skill", filePath, baseDir: dir, sourceInfo: createSyntheticSourceInfo(filePath, { source: "test" }) };
+	return {
+		loader: { ...baseLoader(), getSkills: () => ({ skills: [skill], diagnostics: [] }) } as never,
+		cleanup: () => rmSync(dir, { recursive: true, force: true }),
+	};
+}
+
+/**
