{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "bin/**/*.mjs",
    "isolation/**/*.mjs",
    "runtime/**/*.mjs",
    "shared/**/*.mjs",
    "vitest.config.ts"
  ]
}
