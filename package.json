{
  "name": "pi-dashboard",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-dashboard": "./bin/pi-dashboard.mjs"
  },
  "files": [
    "app",
    "bin",
    "cli",
    "runtime",
    "shared",
    "isolation",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --project tsconfig.app.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.*' --exclude '**/*.tmux.test.*'",
    "test:integration": "vitest run '**/*.integration.test.*'",
    "pack:check": "npm pack --dry-run --json"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
