+/**
+ * Seam A: the native submission barrier.
+ *
+ * A managed host (pi-agents) registers one `NativeSubmitHost` per Pi process. Every native submission
+ * entry point then asks the host for authorization **before** Pi performs its first semantic mutation for
+ * that submission, and consumes a one-use binding fence atomically with that mutation.
+ *
+ * Nothing here persists anything, owns any policy, or knows what a session is. The durable ledger,
+ * attachment blob storage, ownership policy and canonical admission live in the host. This file is the
+ * control point and the vocabulary, and nothing else.
+ *
+ * With no host registered the barrier is inert: every entry point takes exactly the path it took before,
+ * so unmanaged Pi behaviour is unchanged.
+ *
+ * Two structural rules make the barrier hard to bypass, and both matter:
+ *
+ * 1. **Forwarding state is opaque, barrier-owned and one-use.** A native entry point that hands a
+ *    submission on to another one passes a `NativeSubmitHandoff`, an unguessable token the barrier minted.
+ *    The grant object itself never crosses a public option bag, and the barrier alone decides, from its own
+ *    recorded stage, whether a redemption may consume a fence or is merely continuing an already-accepted
+ *    submission. A caller cannot assert "already dispatched", and it cannot replay a token: a handoff
+ *    redeems **once**, so a duplicate `PromptOptions.nativeSubmit` dispatches nothing even though that
+ *    option is public and any caller can present the same token twice.
+ * 2. **The critical section is synchronous.** Fence validation, fence consumption and the first mutation
+ *    run in one uninterrupted turn, so a rebind cannot interleave and the section is never held across an
+ *    extension handler, a child submission or a model turn.
+ */
+
+import { createHash, randomUUID } from "node:crypto";
+import type { ImageContent } from "@earendil-works/pi-ai";
+
+/** Every native entry point that can start a submission. */
+export type NativeSubmitSource =
+	| "native-editor"
+	| "native-followup"
+	| "native-steer"
+	| "compaction-queue"
+	| "builtin-command"
+	| "extension-command"
+	| "startup-prompt"
+	| "extension-api";
+
+export type NativeSubmitIntent = "prompt" | "steer" | "follow_up" | "command";
+
+/**
+ * One attachment, as the host needs it to authorize.
+ *
+ * Pi's native attachment representation is `ImageContent` (`{ type, data: base64, mimeType }`). The
+ * descriptor fields are derived from it and `bytes` is the decoded payload, so a host that must persist
+ * the blob before authorizing has the actual bytes rather than a descriptor it cannot store. Pi stores
+ * nothing: the buffer is the host's to keep or drop.
+ */
+export interface NativeSubmitAttachment {
+	kind: "image" | "file";
+	mediaType: string;
+	byteLength: number;
+	sha256: string;
+	bytes: Uint8Array;
+}
+
+export interface NativeSubmitBinding {
+	/** The canonical session file this owner writes now, or undefined before the first save. */
+	canonicalFile: string | undefined;
+	/** Monotonic per owner; advances whenever the owner's own canonical file changes. */
+	generation: number;
+}
+
+export interface SubmissionEnvelope {
+	/** Minted by Pi. Stable across transform, queue, drain and resource reload within the owner lifetime. */
+	submissionId: string;
+	ownerRunId: string;
+	binding: NativeSubmitBinding;
+	source: NativeSubmitSource;
+	intent: NativeSubmitIntent;
+	/** Before trim, paste-marker expansion, transform, template or skill expansion. */
+	originalText: string;
+	attachments?: NativeSubmitAttachment[];
+	behavior: "idle" | "streaming";
+	/** The native draft revision this gesture submitted; 0 where the entry point has no draft. */
+	draftRevision: number;
+	parentSubmissionId?: string;
+}
+
+/** One-use, consumed atomically with the first native mutation or command dispatch. */
+export interface SubmissionFence {
+	submissionId: string;
+	ownerRunId: string;
+	bindingGeneration: number;
+	nonce: string;
+}
+
+export type NativeSubmitRefusalCode =
+	| "PERSISTENCE_FAILED"
+	| "PERSISTENCE_UNCERTAIN"
+	| "STALE_BINDING"
+	| "DUPLICATE_SUBMISSION"
+	| "REFUSED";
+
+export type NativeSubmitAuthorization =
+	| { authorized: true; fence: SubmissionFence }
+	| { authorized: false; code: NativeSubmitRefusalCode; reason: string };
+
+export type EffectivePayloadOrigin = "transform" | "template" | "skill" | "queue-drain";
+
+export interface EffectivePayloadRecord {
+	submissionId: string;
+	effectiveText: string;
+	expandedFrom: EffectivePayloadOrigin;
+}
+
+/** A receipt for a payload record. Never another grant. */
+export type EffectivePayloadReceipt = { recorded: true } | { recorded: false; code: string; reason: string };
+
+/**
+ * How a submission was applied.
+ *
+ * `queued` is terminal acceptance for that submission, not proof of model completion. `drain-failed` is
+ * the separate later report required when a drain or payload record fails **after** acceptance: it is not
+ * a clean pre-mutation refusal and it never rewrites the queue receipt.
+ */
+export type NativeSubmitOutcome =
+	| { submissionId: string; appliedAs: "applied" | "queued" | "handled" | "discarded" }
+	| {
+			submissionId: string;
+			appliedAs: "refused";
+			code: "STALE_BINDING" | "DUPLICATE_SUBMISSION";
+			beforeMutation: true;
+	  }
+	| { submissionId: string; appliedAs: "drain-failed"; reason: string; afterAcceptance: true };
+
+export interface NativeSubmitHost {
+	/** One owner process lifetime. Recorded in every envelope and every fence. */
+	ownerRunId: string;
+	beforeNativeSubmit(envelope: SubmissionEnvelope): Promise<NativeSubmitAuthorization>;
+	recordEffectivePayload(record: EffectivePayloadRecord): Promise<EffectivePayloadReceipt>;
+	nativeSubmitOutcome(outcome: NativeSubmitOutcome): void;
+}
+
+export interface NativeSubmitRequest {
+	source: NativeSubmitSource;
+	intent: NativeSubmitIntent;
+	/** Untouched: no trim, no paste-marker expansion, no template or skill expansion. */
+	originalText: string;
+	images?: ImageContent[];
+	behavior: "idle" | "streaming";
+	draftRevision?: number;
+	parentSubmissionId?: string;
+}
+
+export interface NativeSubmitRefusal {
+	code: NativeSubmitRefusalCode;
+	reason: string;
+	submissionId: string;
+}
+
+/** Thrown by a managed entry point that refused before any mutation. */
+export class NativeSubmissionRefusedError extends Error {
+	readonly code: NativeSubmitRefusalCode;
+	readonly submissionId: string;
+	readonly beforeMutation = true;
+
+	constructor(refusal: NativeSubmitRefusal) {
+		super(`native submission refused (${refusal.code}): ${refusal.reason}`);
+		this.name = "NativeSubmissionRefusedError";
+		this.code = refusal.code;
+		this.submissionId = refusal.submissionId;
+	}
+}
+
+export type NativeSubmitDispatch<T> =
+	| { dispatched: true; value: T }
+	| { dispatched: false; code: "STALE_BINDING" | "DUPLICATE_SUBMISSION" | "REFUSED"; reason: string };
+
+/**
+ * An opaque, unguessable, barrier-issued token. It is the **only** thing a native entry point passes to
+ * another one, and a caller can neither construct it nor tell the barrier what stage it is at.
+ */
+export type NativeSubmitHandoff = string;
+
+/**
+ * A granted submission, held only by the native entry point the barrier handed it to. `dispatch` is the
+ * one way to perform the first mutation and can succeed at most once.
+ */
+export interface NativeSubmitAccepted {
+	readonly submissionId: string;
+	readonly handoff: NativeSubmitHandoff;
+	/** Exactly what the operator submitted, before any Pi transformation. */
+	readonly originalText: string;
+	readonly source: NativeSubmitSource;
+	/**
+	 * Validate and consume the one-use fence, then run `mutate`, both inside the barrier's synchronous
+	 * critical section. `mutate` must be synchronous.
+	 */
+	dispatch<T>(mutate: () => T): NativeSubmitDispatch<T>;
+	/**
+	 * Register the work this submission's fence consumption owes, run in the same turn as the first
+	 * mutation and only after it succeeded. It is how a native entry point that **retained** the operator's
+	 * draft across a later boundary destroys that draft exactly when the boundary acts: a refusal never
+	 * runs it, so the complete draft survives. At most one registration, run at most once.
+	 *
+	 * `reportFailure` is the registering entry point's own error channel, and it is required: a commit that
+	 * throws cannot un-accept a dispatched submission, so the failure is surfaced there instead of being
+	 * discarded. The submission stays accepted either way.
+	 */
+	afterDispatch(commit: () => void, reportFailure: (error: unknown) => void): void;
+	/** A receipt for the text Pi will actually send. Never a fresh grant. */
+	recordEffectivePayload(effectiveText: string, expandedFrom: EffectivePayloadOrigin): Promise<EffectivePayloadReceipt>;
+	outcome(appliedAs: "applied" | "queued" | "handled" | "discarded"): void;
+	/** A failure that happened after this submission was already accepted. Never a pre-mutation refusal. */
+	reportPostAcceptanceFailure(reason: string): void;
+}
+
+export type NativeSubmitGrant =
+	| { managed: false }
+	| { managed: true; granted: false; refusal: NativeSubmitRefusal }
+	| { managed: true; granted: true; submission: NativeSubmitAccepted };
+
+/**
+ * The result of redeeming a handoff. `mode` comes from the barrier's own recorded stage, never from the
+ * caller: `consume` means this call owns the unconsumed fence, `accepted` means the fence was already
+ * consumed and this call is the single continuation that submission owes, which may only record and report.
+ *
+ * A handoff redeems **once**. The second redemption of the same token is refused as a
+ * `DUPLICATE_SUBMISSION`, whether the first one consumed the fence or continued an accepted submission, so
+ * a replayed token dispatches neither an extension command nor an ordinary agent prompt.
+ */
+export type NativeSubmitRedemption =
+	| { ok: true; mode: "consume" | "accepted"; submission: NativeSubmitAccepted }
+	| { ok: false; code: NativeSubmitRefusalCode; reason: string; submissionId: string };
+
+export interface NativeSubmitRedeemExpectation {
+	/** The untouched operator text this call believes it is acting for. Omitted only for a drain. */
+	originalText?: string;
+	source?: NativeSubmitSource;
+	/** This call is the drain of an already-accepted queued submission. */
+	drain?: boolean;
+}
+
+type SubmissionStage = "RECEIVED" | "GRANTED" | "DISPATCH_STARTED" | "REFUSED";
+
+interface SubmissionRecord {
+	envelope: SubmissionEnvelope;
+	/** Reassigned when the same owner re-registers its host, e.g. after a resource reload. */
+	host: NativeSubmitHost;
+	handoff: NativeSubmitHandoff;
+	fence: SubmissionFence | undefined;
+	stage: SubmissionStage;
+	/** The effective text recorded for this submission, if any expansion happened. */
+	recordedEffectiveText: string | undefined;
+	/** Work the entry point that retained the operator's draft owes to this fence's consumption. */
+	afterDispatch: (() => void) | undefined;
+	/** Where a failing `afterDispatch` commit is reported: the registering entry point's error channel. */
+	afterDispatchFailure: ((error: unknown) => void) | undefined;
+	/**
+	 * Whether this submission's single handoff redemption has been spent. Every native flow redeems a
+	 * handoff exactly once — the post-queue continuation of an idle editor push, the drain of a compaction
+	 * queue entry, or the forwarding call that consumes the fence itself — so one redemption is the whole
+	 * budget and a replay has none left.
+	 */
+	redeemed: boolean;
+	outcomeReported: boolean;
+	drainFailureReported: boolean;
+}
+
+/**
+ * The owner-local barrier.
+ *
+ * The critical section is a **synchronous** region, which is how "release before awaiting an arbitrary
+ * extension handler, and never hold it for a model turn" is satisfied by construction rather than by
+ * discipline. The canonical binding is **observed** from the owner's own active session through a
+ * registered supplier, so a temporary `SessionManager` opened to rename or inspect some other session can
+ * never move this owner's binding.
+ */
+export class NativeSubmissionBarrier {
+	#host: NativeSubmitHost | undefined;
+	#ownerCanonicalFile: (() => string | undefined) | undefined;
+	#observed: NativeSubmitBinding = { canonicalFile: undefined, generation: 0 };
+	#submissions = new Map<string, SubmissionRecord>();
+	#byHandoff = new Map<NativeSubmitHandoff, string>();
+	#inCriticalSection = false;
+	#minted = 0;
+
+	get managed(): boolean {
+		return this.#host !== undefined;
+	}
+
+	get ownerRunId(): string | undefined {
+		return this.#host?.ownerRunId;
+	}
+
+	/** Register the managed host, or pass undefined to return to unmanaged behaviour. */
+	setHost(host: NativeSubmitHost | undefined): void {
+		const previous = this.#host;
+		this.#host = host;
+		// Submission identity is owner-lifetime, not host-object-lifetime. A management extension is
+		// re-registered on every resource reload, and `AgentSession.reload` rebuilds extensions while
+		// submissions accepted before the reload are still queued and still owe a drain. Re-registration by
+		// the **same owner** therefore keeps every record and handoff, and only the callable host moves.
+		if (host && previous && host.ownerRunId === previous.ownerRunId) {
+			for (const record of this.#submissions.values()) record.host = host;
+			return;
+		}
+		// A different owner, or deactivation, is a different lifetime: nothing carries over. Records for the
+		// previous owner are dropped rather than reassigned, so a stale handoff cannot be redeemed against a
+		// host that never authorized it.
+		this.#submissions.clear();
+		this.#byHandoff.clear();
+	}
+
+	/**
+	 * Register the owner's active canonical session. Only this supplier moves the binding: a temporary
+	 * `SessionManager` opened for a rename, an import or a listing is not the owner's session and is
+	 * invisible here. Pass undefined when the owner's session is disposed.
+	 */
+	bindOwnerSession(canonicalFile: (() => string | undefined) | undefined): void {
+		this.#ownerCanonicalFile = canonicalFile;
+		this.#observeBinding();
+	}
+
+	/** The binding as last observed. Reading it observes it. */
+	get binding(): NativeSubmitBinding {
+		return { ...this.#observeBinding() };
+	}
+
+	/**
+	 * Observe the owner's canonical file. The generation advances only when the owner's own file actually
+	 * changed, which is what makes a stale fence real rather than synthetic.
+	 */
+	#observeBinding(): NativeSubmitBinding {
+		const current = this.#ownerCanonicalFile?.();
+		if (current !== this.#observed.canonicalFile) {
+			this.#observed = { canonicalFile: current, generation: this.#observed.generation + 1 };
+		}
+		return this.#observed;
+	}
+
+	/** The stage a submission id reached, for a duplicate lookup. */
+	stageOf(submissionId: string): SubmissionStage | undefined {
+		return this.#submissions.get(submissionId)?.stage;
+	}
+
+	/**
+	 * Ask the host to authorize one submission. Resolves before Pi's first semantic mutation for it. A
+	 * refusal, a thrown handler, a rejected promise or a missing/ill-formed authorization all refuse.
+	 */
+	async begin(request: NativeSubmitRequest): Promise<NativeSubmitGrant> {
+		const host = this.#host;
+		if (!host) return { managed: false };
+
+		const submissionId = `${host.ownerRunId}:${++this.#minted}:${randomUUID()}`;
+		const binding = { ...this.#observeBinding() };
+		const envelope: SubmissionEnvelope = {
+			submissionId,
+			ownerRunId: host.ownerRunId,
+			binding,
+			source: request.source,
+			intent: request.intent,
+			originalText: request.originalText,
+			behavior: request.behavior,
+			draftRevision: request.draftRevision ?? 0,
+		};
+		const attachments = describeAttachments(request.images);
+		if (attachments) envelope.attachments = attachments;
+		if (request.parentSubmissionId) envelope.parentSubmissionId = request.parentSubmissionId;
+
+		const record: SubmissionRecord = {
+			envelope,
+			host,
+			handoff: `handoff:${randomUUID()}`,
+			fence: undefined,
+			stage: "RECEIVED",
+			recordedEffectiveText: undefined,
+			afterDispatch: undefined,
+			afterDispatchFailure: undefined,
+			redeemed: false,
+			outcomeReported: false,
+			drainFailureReported: false,
+		};
+		this.#submissions.set(submissionId, record);
+
+		let authorization: NativeSubmitAuthorization | undefined;
+		try {
+			authorization = await host.beforeNativeSubmit(envelope);
+		} catch (error) {
+			return this.#refuse(record, "REFUSED", `authorization handler failed: ${describeError(error)}`);
+		}
+		if (!authorization || typeof authorization !== "object") {
+			return this.#refuse(record, "REFUSED", "authorization handler returned no decision");
+		}
+		if (!authorization.authorized) {
+			const code = authorization.code ?? "REFUSED";
+			return this.#refuse(record, code, authorization.reason ?? "no reason given");
+		}
+		const fence = authorization.fence;
+		if (
+			!fence ||
+			fence.submissionId !== submissionId ||
+			fence.ownerRunId !== host.ownerRunId ||
+			fence.bindingGeneration !== envelope.binding.generation ||
+			!fence.nonce
+		) {
+			return this.#refuse(record, "REFUSED", "authorization carried no fence matching this submission");
+		}
+
+		record.stage = "GRANTED";
+		record.fence = fence;
+		this.#byHandoff.set(record.handoff, submissionId);
+		return { managed: true, granted: true, submission: this.#accepted(record) };
+	}
+
+	/**
+	 * Redeem an opaque handoff. The barrier decides the mode from its own recorded stage; a caller cannot
+	 * claim a submission was already dispatched, and cannot redeem a handoff for different content.
+	 */
+	redeem(handoff: NativeSubmitHandoff, expect: NativeSubmitRedeemExpectation): NativeSubmitRedemption {
+		const host = this.#host;
+		const submissionId = typeof handoff === "string" ? this.#byHandoff.get(handoff) : undefined;
+		const record = submissionId ? this.#submissions.get(submissionId) : undefined;
+		if (!host || !record) {
+			return {
+				ok: false,
+				code: "REFUSED",
+				reason: "the handoff is not a live barrier-issued token for this owner",
+				submissionId: submissionId ?? "unknown",
+			};
+		}
+		// Narrowed: a live record always carries its own id.
+		const id = record.envelope.submissionId;
+		if (record.host.ownerRunId !== host.ownerRunId) {
+			return { ok: false, code: "REFUSED", reason: "the handoff belongs to a different owner", submissionId: id };
+		}
+		if (expect.source !== undefined && expect.source !== record.envelope.source) {
+			return {
+				ok: false,
+				code: "REFUSED",
+				reason: `the handoff was granted for source ${record.envelope.source}, not ${expect.source}`,
+				submissionId: id,
+			};
+		}
+		// A drain acts on the expanded text, so it presents no original text; every other redemption must
+		// present exactly the text the grant was taken for.
+		if (!expect.drain) {
+			if (expect.originalText !== record.envelope.originalText) {
+				return {
+					ok: false,
+					code: "REFUSED",
+					reason: "the handoff was granted for different operator text",
+					submissionId: id,
+				};
+			}
+		}
+		// One-use redemption accounting. A handoff buys exactly one forwarding step, and which step that is
+		// depends only on the stage the barrier recorded: the call that consumes the fence, or the single
+		// continuation an already-accepted submission owes its queue. Spending it here, synchronously and
+		// before this call does any work, is also what makes two overlapping redemptions safe: the second
+		// one is refused even while the first is still awaiting its own boundary.
+		if (record.redeemed) {
+			host.nativeSubmitOutcome({
+				submissionId: id,
+				appliedAs: "refused",
+				code: "DUPLICATE_SUBMISSION",
+				beforeMutation: true,
+			});
+			return {
+				ok: false,
+				code: "DUPLICATE_SUBMISSION",
+				reason: "this handoff was already redeemed; a handoff is one-use and cannot be replayed",
+				submissionId: id,
+			};
+		}
+		if (record.stage === "GRANTED") {
+			if (expect.drain) {
+				return { ok: false, code: "REFUSED", reason: "a drain requires an accepted submission", submissionId: id };
+			}
+			record.redeemed = true;
+			return { ok: true, mode: "consume", submission: this.#accepted(record) };
+		}
+		if (record.stage === "DISPATCH_STARTED") {
+			record.redeemed = true;
+			return { ok: true, mode: "accepted", submission: this.#accepted(record) };
+		}
+		return {
+			ok: false,
+			code: "DUPLICATE_SUBMISSION",
+			reason: `submission is at ${record.stage}`,
+			submissionId: id,
+		};
+	}
+
+	#refuse(record: SubmissionRecord, code: NativeSubmitRefusalCode, reason: string): NativeSubmitGrant {
+		record.stage = "REFUSED";
+		record.fence = undefined;
+		this.#byHandoff.delete(record.handoff);
+		return { managed: true, granted: false, refusal: { code, reason, submissionId: record.envelope.submissionId } };
+	}
+
+	#accepted(record: SubmissionRecord): NativeSubmitAccepted {
+		const barrier = this;
+		const submissionId = record.envelope.submissionId;
+		return {
+			submissionId,
+			handoff: record.handoff,
+			originalText: record.envelope.originalText,
+			source: record.envelope.source,
+			dispatch<T>(mutate: () => T): NativeSubmitDispatch<T> {
+				return barrier.#dispatch(record, mutate);
+			},
+			afterDispatch(commit, reportFailure) {
+				record.afterDispatch = commit;
+				record.afterDispatchFailure = reportFailure;
+			},
+			recordEffectivePayload(effectiveText, expandedFrom) {
+				return barrier.#record(record, { submissionId, effectiveText, expandedFrom });
+			},
+			outcome(appliedAs) {
+				if (record.outcomeReported) return;
+				record.outcomeReported = true;
+				record.host.nativeSubmitOutcome({ submissionId, appliedAs });
+			},
+			reportPostAcceptanceFailure(reason) {
+				if (record.drainFailureReported) return;
+				record.drainFailureReported = true;
+				record.host.nativeSubmitOutcome({ submissionId, appliedAs: "drain-failed", reason, afterAcceptance: true });
+			},
+		};
+	}
+
+	#dispatch<T>(record: SubmissionRecord, mutate: () => T): NativeSubmitDispatch<T> {
+		if (this.#inCriticalSection) {
+			throw new Error("native submission barrier: dispatch cannot be re-entered from inside a mutation");
+		}
+		const submissionId = record.envelope.submissionId;
+		const host = record.host;
+		if (record.stage !== "GRANTED" || !record.fence) {
+			host.nativeSubmitOutcome({
+				submissionId,
+				appliedAs: "refused",
+				code: "DUPLICATE_SUBMISSION",
+				beforeMutation: true,
+			});
+			return {
+				dispatched: false,
+				code: "DUPLICATE_SUBMISSION",
+				reason: record.fence ? `submission already at ${record.stage}` : "the fence was already consumed",
+			};
+		}
+		// The owner's own canonical file is re-observed here, inside the same turn as the mutation.
+		const binding = this.#observeBinding();
+		if (record.fence.bindingGeneration !== binding.generation) {
+			record.fence = undefined;
+			record.stage = "REFUSED";
+			this.#byHandoff.delete(record.handoff);
+			host.nativeSubmitOutcome({
+				submissionId,
+				appliedAs: "refused",
+				code: "STALE_BINDING",
+				beforeMutation: true,
+			});
+			return {
+				dispatched: false,
+				code: "STALE_BINDING",
+				reason: `fence was granted at binding generation ${record.envelope.binding.generation}, the owner is now at ${binding.generation}`,
+			};
+		}
+
+		this.#inCriticalSection = true;
+		let value: T;
+		try {
+			record.fence = undefined;
+			record.stage = "DISPATCH_STARTED";
+			value = mutate();
+		} finally {
+			this.#inCriticalSection = false;
+		}
+		// The retained draft dies here: in the same turn as the mutation, and only after it committed. It runs
+		// outside the critical section because clearing a draft is not a mutation of this submission, and a
+		// component that throws while clearing cannot un-accept a submission that already dispatched.
+		const commit = record.afterDispatch;
+		const reportCommitFailure = record.afterDispatchFailure;
+		record.afterDispatch = undefined;
+		record.afterDispatchFailure = undefined;
+		try {
+			commit?.();
+		} catch (error) {
+			// Surfaced through the channel the registering entry point owns — for the default editor, the same
+			// error line every other refused submission uses — rather than discarded. It is not reported by
+			// unwinding an accepted dispatch: the mutation committed, so the submission stays accepted.
+			try {
+				reportCommitFailure?.(error);
+			} catch {
+				// The reporter *is* the owning error channel, so a reporter that throws leaves none. Deliberate,
+				// documented last resort: the accepted dispatch still stands and nothing is retried here.
+			}
+		}
+		return { dispatched: true, value };
+	}
+
+	async #record(record: SubmissionRecord, payload: EffectivePayloadRecord): Promise<EffectivePayloadReceipt> {
+		try {
+			const receipt = await record.host.recordEffectivePayload(payload);
+			if (!receipt || typeof receipt !== "object") {
+				return { recorded: false, code: "NO_RECEIPT", reason: "the host returned no receipt" };
+			}
+			if (receipt.recorded) record.recordedEffectiveText = payload.effectiveText;
+			return receipt;
+		} catch (error) {
+			return { recorded: false, code: "RECORD_FAILED", reason: describeError(error) };
+		}
+	}
+
+	/**
+	 * A drain that failed after its submission was already accepted, reported by id because the failing
+	 * caller may hold only the queue record. Never a pre-mutation refusal, and never a replay.
+	 */
+	reportDrainFailure(submissionId: string, reason: string): void {
+		const record = this.#submissions.get(submissionId);
+		if (!record || record.stage !== "DISPATCH_STARTED" || record.drainFailureReported) return;
+		record.drainFailureReported = true;
+		record.host.nativeSubmitOutcome({ submissionId, appliedAs: "drain-failed", reason, afterAcceptance: true });
+	}
+}
+
+/** One barrier per Pi process: one whole Pi is one owner. */
+export const nativeSubmissionBarrier = new NativeSubmissionBarrier();
+
+/**
+ * Register the managed submission host. This is the opt-in: until it is called, every native entry point
+ * behaves exactly as unmanaged Pi does.
+ */
+export function setNativeSubmissionHost(host: NativeSubmitHost | undefined): void {
+	nativeSubmissionBarrier.setHost(host);
+}
+
+/**
+ * How a call into a native entry point relates to the barrier.
+ *
+ * `handoff` is opaque and barrier-issued: it is the only forwarding state that crosses a public option
+ * bag, and the barrier decides from its own recorded stage whether that redemption may consume a fence.
+ */
+export interface NativeSubmitEntry {
+	source?: NativeSubmitSource;
+	handoff?: NativeSubmitHandoff;
+	/** This call is the drain of an already-accepted queued submission. */
+	drain?: boolean;
+	/** The untouched operator text a forwarded submission was granted for, when it differs from `text`. */
+	originalText?: string;
+}
+
+/**
+ * Map Pi's native attachment representation onto the envelope's descriptors plus the actual bytes.
+ * `ImageContent.data` is base64, so `bytes` is its decoding and `byteLength`/`sha256` describe those
+ * bytes, not the base64 text.
+ */
+export function describeAttachments(images: ImageContent[] | undefined): NativeSubmitAttachment[] | undefined {
+	if (!images || images.length === 0) return undefined;
+	return images.map((image) => {
+		const bytes = Buffer.from(image.data, "base64");
+		return {
+			kind: "image" as const,
+			mediaType: image.mimeType,
+			byteLength: bytes.byteLength,
+			sha256: createHash("sha256").update(bytes).digest("hex"),
+			bytes,
+		};
