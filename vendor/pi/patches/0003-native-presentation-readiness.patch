index 0000000000000000000000000000000000000000..e86bbfbccdc07ac05cb26117f24ed3dfea5f0c87
--- /dev/null
+++ b/packages/coding-agent/src/core/native-bootstrap.ts
@@ -0,0 +1,481 @@
+/**
+ * Seam E core bootstrap: the launch-time readiness sideband, opened before any extension is loaded.
+ *
+ * The snapshot route in `native-presentation.ts` answers a *registrant* that arrives late. It cannot answer
+ * a host at all when an arbitrary extension's `session_start` handler never resolves, because the
+ * management extension behind it never registers. Extensions are not a supported bootstrap route for a
+ * launch-time fact.
+ *
+ * This channel is opened by `main()` before extension modules are loaded, before the TUI mounts and before
+ * any `session_start` handler exists. The host creates a unix-domain listener, passes its path in
+ * `PI_NATIVE_BOOTSTRAP_SOCKET`, and launches Pi; Pi connects out and streams readiness records as they are
+ * recorded. Nothing an extension does can hide or delay them.
+ *
+ * The channel carries exactly two things: readiness records, and presentation requests for the terminal Pi
+ * already owns. It is not a session manager, not a transport for input, and not an RPC surface: those are
+ * other seams' work and are deliberately absent.
+ *
+ * Failure is reported, never thrown. A host that is not listening, a stale socket path or a closed peer
+ * leaves Pi running exactly as an unmanaged Pi runs; {@link nativeBootstrapStatus} names what happened.
+ *
+ * The inbound side is bounded and fail-closed. A command is one newline-terminated JSON object of at most
+ * {@link NATIVE_BOOTSTRAP_MAX_COMMAND_BYTES} bytes, carrying `protocol: 1` and exactly the fields
+ * {@link NativeBootstrapCommand} names; anything else is answered with one `error` frame and acted on in no
+ * other way. Input that never terminates a frame within the bound, or a frame larger than it, closes the
+ * channel instead of growing a retained string. The bound is measured on the **raw** frame the peer sent,
+ * newline and whitespace included, before anything is trimmed, normalized or parsed: padding a command out
+ * with whitespace must not buy a peer bytes Pi promised not to accept. A breach closes admission before the
+ * refusal is flushed, so neither a frame already buffered behind the breach nor one arriving on a later data
+ * event can reach `presentTerminal`. Nothing crossing this boundary is cast: each field is validated and
+ * copied, so a host cannot reach `presentTerminal` with a value it did not declare.
+ */
+
+import * as net from "node:net";
+import {
+	NATIVE_PRESENTATION_CAPABILITY,
+	nativeReadiness,
+	nativeReadinessSnapshot,
+	presentTerminal,
+	type PresentTerminalRequest,
+	type PresentTerminalResult,
+	type ReadinessRecord,
+} from "./native-presentation.ts";
+
+/** The environment variable a host sets to the path of the unix-domain listener it already created. */
+export const NATIVE_BOOTSTRAP_SOCKET_ENV = "PI_NATIVE_BOOTSTRAP_SOCKET";
+
+export const NATIVE_BOOTSTRAP_PROTOCOL = 1;
+
+/**
+ * The largest inbound command frame this channel accepts, in bytes, newline included.
+ *
+ * A presentation request is a few hundred bytes. The bound exists so a peer cannot make Pi retain an
+ * unbounded string: input that passes it without terminating a frame is refused and the channel closes.
+ */
+export const NATIVE_BOOTSTRAP_MAX_COMMAND_BYTES = 8192;
+
+/** Bounds on the two host-supplied identifiers Pi echoes back. */
+const MAX_REQUEST_ID_LENGTH = 200;
+const MAX_ATTACHMENT_ID_LENGTH = 200;
+
+/** Pi to host. */
+export type NativeBootstrapFrame =
+	/** Sent once, immediately on connection, before anything else. */
+	| {
+			type: "native-bootstrap";
+			protocol: typeof NATIVE_BOOTSTRAP_PROTOCOL;
+			pid: number;
+			capability: typeof NATIVE_PRESENTATION_CAPABILITY;
+			/** Phases already reached when the channel opened. Empty at launch, non-empty on a late open. */
+			reached: ReadinessRecord[];
+	  }
+	/** One per phase, as it is recorded. */
+	| { type: "native-readiness"; protocol: typeof NATIVE_BOOTSTRAP_PROTOCOL; readiness: ReadinessRecord }
+	| {
+			type: "presentation-result";
+			protocol: typeof NATIVE_BOOTSTRAP_PROTOCOL;
+			requestId: string;
+			result: PresentTerminalResult;
+	  }
+	/**
+	 * One refusal, for one inbound frame Pi did not act on: unparseable, not an object, another protocol
+	 * version, an unsupported command, a field that is missing or not the declared type, a frame past the
+	 * byte bound, or a presentation that threw. `requestId` is echoed when the host supplied a usable one.
+	 */
+	| { type: "error"; protocol: typeof NATIVE_BOOTSTRAP_PROTOCOL; requestId: string | undefined; error: string };
+
+/**
+ * Host to Pi. The only command. `requestId` is the host's own correlation id and is echoed on the reply.
+ *
+ * `protocol` is required inbound as well as outbound: a host built against a later channel must be refused
+ * by version rather than partially understood by field.
+ */
+export type NativeBootstrapCommand = {
+	type: "present";
+	protocol: typeof NATIVE_BOOTSTRAP_PROTOCOL;
+	requestId: string;
+} & PresentTerminalRequest;
+
+export type NativeBootstrapState = "unconfigured" | "connecting" | "open" | "closed" | "failed";
+
+export type NativeBootstrapStatus = {
+	state: NativeBootstrapState;
+	socketPath: string | undefined;
+	/** Frames Pi has handed to the socket, so a test or a host can tell silence from a lost connection. */
+	framesSent: number;
+	lastError: string | undefined;
+};
+
+/**
+ * The channel lives on the process, for the same reason the ledger does: the bundled CLI inlines its
+ * dependencies, so a second copy of this module must find the channel that is already open rather than open a
+ * second socket and report `unconfigured`. Same rules — a version on the record, reuse instead of reset, and a
+ * clear refusal when an existing record is one this build cannot speak to.
+ */
+const NATIVE_BOOTSTRAP_STATE = Symbol.for("@earendil-works/pi-coding-agent/native-bootstrap-state");
+export const NATIVE_BOOTSTRAP_STATE_VERSION = 1;
+
+type NativeBootstrapChannel = {
+	version: number;
+	socket: net.Socket | undefined;
+	unsubscribe: (() => void) | undefined;
+	state: NativeBootstrapState;
+	socketPath: string | undefined;
+	framesSent: number;
+	lastError: string | undefined;
+	inbound: string;
+	/** The hello is the first frame on the socket. Nothing else is written before it. */
+	helloSent: boolean;
+	/** Readiness recorded before the hello. Delivered after it, and only what the hello did not carry. */
+	pendingReadiness: ReadinessRecord[];
+	/** Every readiness `sequence` already written or carried in the hello, so no record is sent twice. */
+	deliveredReadiness: Set<number>;
+};
+
+function isUsableChannel(candidate: unknown): candidate is NativeBootstrapChannel {
+	const record = candidate as Partial<NativeBootstrapChannel> | undefined;
+	return (
+		record?.version === NATIVE_BOOTSTRAP_STATE_VERSION &&
+		typeof record.state === "string" &&
+		typeof record.framesSent === "number" &&
+		typeof record.inbound === "string" &&
+		typeof record.helloSent === "boolean" &&
+		Array.isArray(record.pendingReadiness) &&
+		record.deliveredReadiness instanceof Set
+	);
+}
+
+function channel(): NativeBootstrapChannel {
+	const carrier = globalThis as Record<PropertyKey, unknown>;
+	const existing = carrier[NATIVE_BOOTSTRAP_STATE];
+	if (existing !== undefined) {
+		if (!isUsableChannel(existing)) {
+			const found = (existing as { version?: unknown })?.version;
+			throw new Error(
+				`native bootstrap state version ${String(found)} is already on this process and this build speaks ` +
+					`version ${NATIVE_BOOTSTRAP_STATE_VERSION}. Two incompatible Pi builds are loaded in one process; ` +
+					`load one, or upgrade the older one. The existing channel is left open and untouched.`,
+			);
+		}
+		return existing;
+	}
+	const created: NativeBootstrapChannel = {
+		version: NATIVE_BOOTSTRAP_STATE_VERSION,
+		socket: undefined,
+		unsubscribe: undefined,
+		state: "unconfigured",
+		socketPath: undefined,
+		framesSent: 0,
+		lastError: undefined,
+		inbound: "",
+		helloSent: false,
+		pendingReadiness: [],
+		deliveredReadiness: new Set(),
+	};
+	carrier[NATIVE_BOOTSTRAP_STATE] = created;
+	return created;
+}
+
+/** Write one frame. The hello goes through this directly; everything else goes through {@link send}. */
+function writeFrame(frame: NativeBootstrapFrame): void {
+	const open = channel();
+	if (!open.socket || open.socket.destroyed) return;
+	// Ordered by the socket itself. `write` returning false means the kernel buffer is full and the bytes
+	// were still accepted, so nothing is resent.
+	open.socket.write(`${JSON.stringify(frame)}\n`);
+	open.framesSent += 1;
+}
+
+/**
+ * Every frame except the hello.
+ *
+ * A socket accepts writes while it is still connecting, so readiness recorded between
+ * {@link startNativeBootstrapChannel} and the connection would otherwise reach the host *before* the hello
+ * that is supposed to open the stream. Such a record waits here instead and is delivered once, after the
+ * hello, if the hello's own snapshot did not already carry it. Frames that only exist as an answer to an
+ * inbound command cannot arrive this early, and are dropped rather than queued.
+ */
+function send(frame: NativeBootstrapFrame): void {
+	const open = channel();
+	if (!open.helloSent) {
+		if (frame.type === "native-readiness") open.pendingReadiness.push(frame.readiness);
+		return;
+	}
+	if (frame.type === "native-readiness") {
+		if (open.deliveredReadiness.has(frame.readiness.sequence)) return;
+		open.deliveredReadiness.add(frame.readiness.sequence);
+	}
+	writeFrame(frame);
+}
+
+function errorFrame(requestId: string | undefined, error: string): NativeBootstrapFrame {
+	return { type: "error", protocol: NATIVE_BOOTSTRAP_PROTOCOL, requestId, error };
+}
+
+function describe(value: unknown): string {
+	if (value === null) return "null";
+	if (Array.isArray(value)) return "array";
+	if (value instanceof Error) return value.message;
+	if (typeof value === "object") return "object";
+	return JSON.stringify(value) ?? typeof value;
+}
+
+/** Why a frame was refused, and the request id to echo when the host supplied a usable one. */
+type CommandRejection = { refused: string; requestId: string | undefined };
+
+function boundedString(value: unknown, limit: number): string | undefined {
+	return typeof value === "string" && value.length > 0 && value.length <= limit ? value : undefined;
+}
+
+/** A count or revision: finite, integral, not negative. `NaN`, `Infinity` and `1.5` are none of those. */
+function boundedInteger(value: unknown): number | undefined {
+	return typeof value === "number" && Number.isSafeInteger(value) && value >= 0 ? value : undefined;
+}
+
+/**
+ * Validate one inbound frame and copy the fields it declares.
+ *
+ * Nothing is cast: the returned command carries only validated values, so no host-supplied shape reaches
+ * `presentTerminal`. `protocol` is checked before `type`, because a frame from another version of this
+ * channel must be refused by version rather than by the field names this version happens to know.
+ */
+function validateCommand(value: unknown): NativeBootstrapCommand | CommandRejection {
+	if (typeof value !== "object" || value === null || Array.isArray(value)) {
+		return { refused: `command must be a JSON object, received ${describe(value)}`, requestId: undefined };
+	}
+	const frame = value as Record<string, unknown>;
+	// Echoed only when the host's own correlation id is a usable bounded string.
+	const requestId = boundedString(frame.requestId, MAX_REQUEST_ID_LENGTH);
+	if (frame.protocol !== NATIVE_BOOTSTRAP_PROTOCOL) {
+		return {
+			refused: `unsupported protocol ${describe(frame.protocol)}; this channel speaks protocol ${NATIVE_BOOTSTRAP_PROTOCOL}`,
+			requestId,
+		};
+	}
+	if (frame.type !== "present") {
+		return { refused: `unsupported command: ${describe(frame.type)}`, requestId };
+	}
+	if (requestId === undefined) {
+		return {
+			refused: `requestId must be a string of 1 to ${MAX_REQUEST_ID_LENGTH} characters`,
+			requestId: undefined,
+		};
+	}
+	const epoch = frame.attachmentEpoch;
+	if (typeof epoch !== "object" || epoch === null || Array.isArray(epoch)) {
+		return { refused: `attachmentEpoch must be an object, received ${describe(epoch)}`, requestId };
+	}
+	const attachment = epoch as Record<string, unknown>;
+	const attachmentId = boundedString(attachment.attachmentId, MAX_ATTACHMENT_ID_LENGTH);
+	const epochNumber = boundedInteger(attachment.epoch);
+	if (attachmentId === undefined || epochNumber === undefined) {
+		return {
+			refused: `attachmentEpoch needs an attachmentId of 1 to ${MAX_ATTACHMENT_ID_LENGTH} characters and a whole epoch, received ${describe(attachment.attachmentId)} and ${describe(attachment.epoch)}`,
+			requestId,
+		};
+	}
+	const geometryRevision = boundedInteger(frame.geometryRevision);
+	if (geometryRevision === undefined) {
+		return { refused: `geometryRevision must be a whole number, received ${describe(frame.geometryRevision)}`, requestId };
+	}
+	if (typeof frame.coldTerminal !== "boolean") {
+		return { refused: `coldTerminal must be a boolean, received ${describe(frame.coldTerminal)}`, requestId };
+	}
+	return {
+		type: "present",
+		protocol: NATIVE_BOOTSTRAP_PROTOCOL,
+		requestId,
+		attachmentEpoch: { attachmentId, epoch: epochNumber },
+		geometryRevision,
+		coldTerminal: frame.coldTerminal,
+	};
+}
+
+async function handleCommand(line: string): Promise<void> {
+	let parsed: unknown;
+	try {
+		parsed = JSON.parse(line);
+	} catch (error) {
+		send(errorFrame(undefined, `unparseable command: ${error instanceof Error ? error.message : String(error)}`));
+		return;
+	}
+	const command = validateCommand(parsed);
+	if ("refused" in command) {
+		send(errorFrame(command.requestId, command.refused));
+		return;
+	}
+	let result: PresentTerminalResult;
+	try {
+		result = await presentTerminal({
+			attachmentEpoch: command.attachmentEpoch,
+			geometryRevision: command.geometryRevision,
+			coldTerminal: command.coldTerminal,
+		});
+	} catch (error) {
+		// A renderer or a host-registered provider can throw. The host asked, so the host is told, and the
+		// channel stays open: a failed presentation is not a reason to drop readiness reporting.
+		send(errorFrame(command.requestId, `presentation failed: ${describe(error)}`));
+		return;
+	}
+	send({ type: "presentation-result", protocol: NATIVE_BOOTSTRAP_PROTOCOL, requestId: command.requestId, result });
+}
+
+/**
+ * Fail closed: shut admission, then name the breach on the socket and close it.
+ *
+ * Admission closes **first**, and on the socket itself, not only on this record. A `data` listener is already
+ * registered and may be called again before the FIN is seen; clearing the record alone would leave it free to
+ * parse the next frame and call `presentTerminal` after the breach. Reads are paused, the listener is removed
+ * and the socket stops being this channel's, so {@link readCommands} refuses anything that still arrives on
+ * it. The refusal is written while the socket is still ours, so the last thing this channel does is answer.
+ */
+function refuseAndClose(message: string): void {
+	const open = channel();
+	const socket = open.socket;
+	socket?.pause();
+	socket?.removeAllListeners("data");
+	send(errorFrame(undefined, message));
+	open.lastError = message;
+	open.unsubscribe?.();
+	open.unsubscribe = undefined;
+	open.inbound = "";
+	// `end` flushes the error frame and then sends FIN; `destroy` could discard it.
+	socket?.end();
+	open.socket = undefined;
+	open.state = "closed";
+}
+
+/**
+ * Read whatever arrived on `source`, which must still be this channel's socket.
+ *
+ * The identity check is the admission gate: a breach sets `open.socket` to `undefined`, so a `data` event
+ * that was already in flight on the closed socket — or one from a socket a previous channel left behind —
+ * buffers nothing, parses nothing and reaches no provider.
+ */
+function readCommands(source: net.Socket, chunk: string): void {
+	const open = channel();
+	if (open.socket !== source) return;
+	open.inbound += chunk;
+	for (;;) {
+		if (open.socket !== source) return;
+		const newline = open.inbound.indexOf("\n");
+		if (newline === -1) {
+			if (Buffer.byteLength(open.inbound) > NATIVE_BOOTSTRAP_MAX_COMMAND_BYTES) {
+				refuseAndClose(
+					`command exceeded ${NATIVE_BOOTSTRAP_MAX_COMMAND_BYTES} bytes with no newline; the channel is closed`,
+				);
+			}
+			return;
+		}
+		// The raw frame the peer sent, newline included, measured before anything is trimmed or parsed: the
+		// bound is on what crossed the socket, not on what survives normalization. Whitespace padding a large
+		// command down under the bound is exactly the bypass this order closes.
+		const frame = open.inbound.slice(0, newline + 1);
+		const frameBytes = Buffer.byteLength(frame);
+		open.inbound = open.inbound.slice(newline + 1);
+		if (frameBytes > NATIVE_BOOTSTRAP_MAX_COMMAND_BYTES) {
+			refuseAndClose(
+				`command of ${frameBytes} bytes exceeds the ${NATIVE_BOOTSTRAP_MAX_COMMAND_BYTES} byte bound; the channel is closed`,
+			);
+			return;
+		}
+		const line = frame.trim();
+		if (!line) continue;
+		// Never discarded: a rejection here is the host's answer, not a silent unhandled rejection.
+		handleCommand(line).catch((error: unknown) => {
+			send(errorFrame(undefined, `command handling failed: ${describe(error)}`));
+		});
+	}
+}
+
+/**
+ * Open the sideband if the host configured one. Idempotent, and safe to call before anything else exists.
+ *
+ * Called from `main()` before extensions are loaded. The subscription is installed before the connection is
+ * attempted, so no phase recorded during the connect can be missed; the hello is still the first frame on
+ * the socket, and a phase recorded before it is carried in the hello's snapshot rather than written ahead
+ * of it.
+ */
+export function startNativeBootstrapChannel(): NativeBootstrapStatus {
+	const open = channel();
+	// Reused, never reset: a second copy of this module finds the channel that is already open.
+	if (open.socket) return nativeBootstrapStatus();
+	open.framesSent = 0;
+	open.lastError = undefined;
+	open.helloSent = false;
+	open.pendingReadiness = [];
+	open.deliveredReadiness = new Set();
+	open.inbound = "";
+	const configured = process.env[NATIVE_BOOTSTRAP_SOCKET_ENV];
+	if (!configured) {
+		open.state = "unconfigured";
+		open.socketPath = undefined;
+		return nativeBootstrapStatus();
+	}
+	open.socketPath = configured;
+	open.state = "connecting";
+	// Subscribed before connecting, so there is no window in which a phase is recorded and no one is
+	// listening. Records that arrive before the hello queue in `send` and are delivered after it, once.
+	open.unsubscribe = nativeReadiness().subscribe((readiness) => {
+		send({ type: "native-readiness", protocol: NATIVE_BOOTSTRAP_PROTOCOL, readiness });
+	});
+	const connection = net.connect(configured);
+	open.socket = connection;
+	// A sideband must not keep Pi alive, and must not crash it either.
+	connection.unref();
+	connection.setEncoding("utf8");
+	connection.on("connect", () => {
+		open.state = "open";
+		const reached = nativeReadinessSnapshot().reached;
+		// The hello, first, before any readiness frame.
+		writeFrame({
+			type: "native-bootstrap",
+			protocol: NATIVE_BOOTSTRAP_PROTOCOL,
+			pid: process.pid,
+			capability: NATIVE_PRESENTATION_CAPABILITY,
+			reached,
+		});
+		open.helloSent = true;
+		// Whatever the snapshot carried is delivered; it is not repeated as an event.
+		for (const entry of reached) open.deliveredReadiness.add(entry.sequence);
+		const queued = open.pendingReadiness;
+		open.pendingReadiness = [];
+		for (const readiness of queued) {
+			send({ type: "native-readiness", protocol: NATIVE_BOOTSTRAP_PROTOCOL, readiness });
+		}
+	});
+	connection.on("data", (chunk: Buffer | string) => {
+		readCommands(connection, typeof chunk === "string" ? chunk : chunk.toString("utf8"));
+	});
+	connection.on("error", (error: Error) => {
+		open.state = "failed";
+		open.lastError = error.message;
+	});
+	connection.on("close", () => {
+		if (open.state !== "failed") open.state = "closed";
+	});
+	return nativeBootstrapStatus();
+}
+
+export function stopNativeBootstrapChannel(): void {
+	const open = channel();
+	open.unsubscribe?.();
+	open.unsubscribe = undefined;
+	open.socket?.destroy();
+	open.socket = undefined;
+	open.inbound = "";
+	open.helloSent = false;
+	open.pendingReadiness = [];
+	open.deliveredReadiness = new Set();
+	if (open.state !== "failed") open.state = open.socketPath ? "closed" : "unconfigured";
+}
+
+export function nativeBootstrapStatus(): NativeBootstrapStatus {
+	const open = channel();
+	return {
+		state: open.state,
+		socketPath: open.socketPath,
+		framesSent: open.framesSent,
+		lastError: open.lastError,
+	};
+}
